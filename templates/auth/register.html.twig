{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
<div class="min-h-[calc(100vh-72px)] flex items-center justify-center px-4 py-12">
  <div class="w-full max-w-md pixel-ui">

    <div class="pixel-card">
      <div class="flex items-center justify-between gap-3">
        <div>
          <div class="pixel-title">INSCRIPTION</div>
          <div class="pixel-subtitle">Crée ton compte en 30 secondes</div>
        </div>
        <div class="pixel-icon-btn" aria-hidden="true">
          <i data-lucide="sparkles" class="w-5 h-5"></i>
        </div>
      </div>

      <div class="pixel-rule my-6"></div>

      {% for message in app.flashes('error') %}
        <div class="pixel-alert pixel-alert--error mb-4">
          <i data-lucide="triangle-alert" class="w-4 h-4"></i>
          <span>{{ message }}</span>
        </div>
      {% endfor %}

      {% for message in app.flashes('success') %}
        <div class="pixel-alert pixel-alert--success mb-4">
          <i data-lucide="badge-check" class="w-4 h-4"></i>
          <span>{{ message }}</span>
        </div>
      {% endfor %}

      <form method="post" class="space-y-4">
        <div>
          <label for="email" class="pixel-label block mb-2">EMAIL</label>
          <div class="pixel-input">
            <i data-lucide="mail" class="w-4 h-4"></i>
            <input
              type="email"
              id="email"
              name="email"
              required
              autofocus
              autocomplete="email"
              placeholder="ton@email.com"
              class="pixel-input__field"
            />
          </div>
        </div>

        <div>
          <label for="password" class="pixel-label block mb-2">MOT DE PASSE</label>
          <div class="pixel-input">
            <i data-lucide="lock" class="w-4 h-4"></i>
            <input
              type="password"
              id="password"
              name="password"
              required
              minlength="6"
              autocomplete="new-password"
              placeholder="min. 6 caractères"
              class="pixel-input__field"
            />
          </div>
          <div class="pixel-muted mt-2">Au moins 6 caractères.</div>
        </div>

        <div>
          <label for="confirm_password" class="pixel-label block mb-2">CONFIRMATION</label>
          <div class="pixel-input">
            <i data-lucide="shield-check" class="w-4 h-4"></i>
            <input
              type="password"
              id="confirm_password"
              name="confirm_password"
              required
              autocomplete="new-password"
              placeholder="retape le mot de passe"
              class="pixel-input__field"
            />
          </div>
        </div>

        <button type="submit" class="pixel-btn is-cta">
          <span class="pixel-btn__ico"><i data-lucide="user-plus" class="w-4 h-4"></i></span>
          <span class="pixel-btn__text">CRÉER MON COMPTE</span>
          <span class="pixel-btn__arrow">▶</span>
        </button>

        <div class="pixel-muted text-center pt-2">
          Déjà un compte ?
          <a href="{{ path('app_login') }}" class="pixel-link-inline">Se connecter</a>
        </div>
      </form>
    </div>

  </div>
</div>
{% endblock %}
