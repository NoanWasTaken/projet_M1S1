<!DOCTYPE html>
<html class="bg-(--pixel-bg)">
  <head>
    <meta charset="UTF-8">
    <title>{% block title %}Welcome!{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
    <script
  src="https://sdk-m1s2.noandelatouche.dev/sdk-frontend/analytix.min.js"
  data-app-id="{{ app.request.server.get('SDK_APP_ID')|default('app_102b9827ad54adf3b1d8421433c246e3') }}"
  data-endpoint="{{ app.request.server.get('SDK_ENDPOINT')|default('https://api-m1s2.noandelatouche.dev/api/v1/ingestion/browser') }}"
  async
></script>

    {% block stylesheets %}
      {{ vite_entry_link_tags('app') }}
      {{ vite_entry_link_tags('chatbot') }}
    {% endblock %}

    {% block javascripts %}
      {{ vite_entry_script_tags('app') }}
      {{ vite_entry_script_tags('chatbot') }}
    {% endblock %}

  </head>

    <body class="min-h-screen overflow-x-hidden">
      <script>
          window.GearForge = { isAuthenticated: {{ app.user ? 'true' : 'false' }} };
      </script>
      <div data-controller="sidebar" class="min-h-screen bg-gradient-to-b from-gray-900 to-gray-800">

        <div class="flex min-h-screen overflow-x-hidden">
            {{ include('components/_sidebar.html.twig') }}

            <main class="flex-1 min-w-0">
              {{ include('components/_header.html.twig') }}
              {% if showIntroDialogue is defined and showIntroDialogue %}
                {% include 'components/_intro_dialogue.html.twig' %}
              {% endif %}
              {% block body %}{% endblock %}
            </main>
        </div>
      </div>     
      
      <div id="global-popup-host" class="pointer-events-none fixed inset-0 z-[999999] flex items-center justify-center p-6">
      </div>

      <div id="gf-cookie-banner" style="
        display: none;
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 99998;
        background: var(--pixel-panel);
        border-top: 3px solid var(--pixel-border);
        box-shadow: 0 -6px 0 0 var(--pixel-shadow);
        font-family: 'Press Start 2P', sans-serif;
        padding: 16px 24px;
      ">
        <div style="max-width: 1100px; margin: 0 auto; display: flex; flex-wrap: wrap; align-items: center; gap: 16px; justify-content: space-between;">
          <div style="flex: 1; min-width: 240px;">
            <p style="font-size: 8px; line-height: 2; color: rgba(233,221,255,0.70); margin: 0;">
              GearForge utilise des cookies pour améliorer votre expérience et mesurer l'audience.
              En continuant, vous acceptez notre&nbsp;
              <a href="{{ path('app_rgpd') }}" style="color: var(--color-mauve-300); text-decoration: none;"
                 onmouseover="this.style.color='var(--pixel-head)'" onmouseout="this.style.color='var(--color-mauve-300)'">
                politique de confidentialité
              </a>.
            </p>
          </div>
          <div style="display: flex; gap: 10px; flex-shrink: 0; flex-wrap: wrap;">
            <button id="gf-cookie-refuse" style="
              font-family: 'Press Start 2P', sans-serif;
              font-size: 8px;
              letter-spacing: 0.1em;
              padding: 10px 16px;
              background: transparent;
              border: 2px solid rgba(233,221,255,0.25);
              color: rgba(233,221,255,0.50);
              cursor: pointer;
              box-shadow: 3px 3px 0 0 var(--pixel-shadow);
              transition: border-color 0.15s, color 0.15s;
            "
            onmouseover="this.style.borderColor='rgba(233,221,255,0.55)'; this.style.color='rgba(233,221,255,0.80)'"
            onmouseout="this.style.borderColor='rgba(233,221,255,0.25)'; this.style.color='rgba(233,221,255,0.50)'">
              REFUSER
            </button>
            <button id="gf-cookie-accept" style="
              font-family: 'Press Start 2P', sans-serif;
              font-size: 8px;
              letter-spacing: 0.1em;
              padding: 10px 16px;
              background: var(--pixel-accent);
              border: 2px solid var(--pixel-border);
              color: var(--pixel-border);
              cursor: pointer;
              box-shadow: 4px 4px 0 0 var(--pixel-shadow);
              transition: transform 0.12s, box-shadow 0.12s;
            "
            onmouseover="this.style.transform='translate(-1px,-1px)'; this.style.boxShadow='6px 6px 0 0 var(--pixel-shadow)'"
            onmouseout="this.style.transform=''; this.style.boxShadow='4px 4px 0 0 var(--pixel-shadow)'">
              ACCEPTER
            </button>
          </div>
        </div>
      </div>

      <script>
        (function () {
          var key = 'gf_cookie_consent';
          var banner = document.getElementById('gf-cookie-banner');
          if (!banner) return;
          if (!localStorage.getItem(key)) {
            banner.style.display = 'block';
          }
          document.getElementById('gf-cookie-accept').addEventListener('click', function () {
            localStorage.setItem(key, 'accepted');
            banner.style.opacity = '0';
            banner.style.transition = 'opacity 0.3s ease';
            setTimeout(function () { banner.style.display = 'none'; }, 300);
          });
          document.getElementById('gf-cookie-refuse').addEventListener('click', function () {
            localStorage.setItem(key, 'refused');
            banner.style.opacity = '0';
            banner.style.transition = 'opacity 0.3s ease';
            setTimeout(function () { banner.style.display = 'none'; }, 300);
          });
        })();
      </script>
    </body>
</html>
