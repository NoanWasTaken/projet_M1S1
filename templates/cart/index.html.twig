{% extends 'base.html.twig' %}

{% block title %}Mon Panier - GearForge{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-b from-gray-900 to-gray-800">
    {% if cart is defined %}
    {% endif %}

    <div class="container mx-auto px-4 py-8">
        <div class="text-center mb-12">
            <h1 class="text-5xl font-bold text-white mb-4">
                Mon <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600">Panier</span>
            </h1>
            <div class="flex flex-col items-center gap-2">
                <button onclick="document.getElementById('import-modal').showModal()" class="inline-block px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Importer un panier</button>
            </div>
            <dialog id="import-modal" class="rounded-xl p-6 bg-gray-900 text-white shadow-xl">
                <style>
                    #import-modal[open] {
                        position: fixed ;
                        top: 50% ;
                        left: 50% ;
                        transform: translate(-50%, -50%) ;
                        margin: 0 ;
                        padding: 0;
                        border: none;
                        background: none;
                        z-index: 1000;
                    }
                    #import-modal > form {
                        box-shadow: 0 8px 40px 0 #000a, 0 0 0 4px #a855f7;
                    }
                    #import-modal::backdrop {
                        background: rgba(20, 20, 30, 0.7);
                    }
                </style>
                <form method="post" action="" id="import-form" class="flex flex-col items-center gap-6 w-[90vw] max-w-xl min-w-[340px] p-8 bg-gradient-to-br from-gray-900 via-gray-800 to-purple-900 rounded-2xl shadow-2xl border-4 border-purple-700">
                    <h2 class="text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600 mb-2 tracking-wider uppercase">Importer un panier</h2>
                    <label for="import-token" class="block mb-2 text-lg font-semibold text-pink-400">Token de partage</label>
                    <input type="text" id="import-token" name="token" class="w-full p-4 mb-2 rounded-lg bg-gray-800 border-2 border-pink-500 focus:border-pink-400 focus:ring-2 focus:ring-pink-500 text-pink-200 font-mono text-center text-xl transition-all outline-none shadow-lg" placeholder="Colle ici le token..." autocomplete="off" required>
                    <div class="flex gap-6 mt-2 w-full justify-center">
                        <button type="submit" class="px-8 py-3 bg-gradient-to-r from-purple-600 to-pink-600 text-white font-bold rounded-xl shadow-lg hover:scale-105 hover:from-pink-600 hover:to-purple-600 transition-all duration-150 flex items-center gap-2 text-lg">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                            Importer
                        </button>
                        <button type="button" onclick="document.getElementById('import-modal').close()" class="px-8 py-3 bg-gray-800 text-gray-300 font-bold rounded-xl border border-gray-600 hover:bg-gray-700 hover:text-white transition-all duration-150 text-lg">Annuler</button>
                    </div>
                </form>
            </dialog>

            <dialog id="save-cart-modal" class="rounded-xl p-6 bg-gray-900 text-white shadow-xl">
                                <style>
                                    #save-cart-modal[open] {
                                        position: fixed ;
                                        top: 50% ;
                                        left: 50% ;
                                        transform: translate(-50%, -50%) ;
                                        margin: 0 ;
                                        padding: 0;
                                        border: none;
                                        background: none;
                                        z-index: 1000;
                                    }
                                    #save-cart-modal > form {
                                        box-shadow: 0 8px 40px 0 #000a, 0 0 0 4px #22c55e;
                                    }
                                    #save-cart-modal::backdrop {
                                        background: rgba(20, 20, 30, 0.7);
                                    }
                                </style>
                <form method="post" action="/cart/save" class="flex flex-col items-center gap-6 w-[90vw] max-w-xl min-w-[340px] p-8 bg-gradient-to-br from-gray-900 via-gray-800 to-purple-900 rounded-2xl shadow-2xl border-4 border-green-700 text-center">
                    <h2 class="text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-blue-600 mb-2 tracking-wider uppercase">Enregistrer le panier</h2>
                    {{ form_start(savedCartForm) }}
                    <div class="mb-4 w-full">
                        <label for="saved_cart_name" class="block mb-2 text-lg font-semibold text-blue-400">Nom du panier</label>
                        {{ form_widget(savedCartForm.name, {'attr': {'class': 'w-full p-4 rounded-lg bg-gray-800 border-2 border-blue-500 focus:border-blue-400 focus:ring-2 focus:ring-blue-500 text-blue-200 font-mono text-center text-xl transition-all outline-none shadow-lg'}}) }}
                    </div>
                    <div class="flex gap-6 mt-2 w-full justify-center">
                        <button type="submit" class="px-8 py-3 bg-gradient-to-r from-green-600 to-blue-600 text-white font-bold rounded-xl shadow-lg hover:scale-105 hover:from-blue-600 hover:to-green-600 transition-all duration-150 flex items-center gap-2 text-lg">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                            Enregistrer
                        </button>
                        <button type="button" onclick="document.getElementById('save-cart-modal').close()" class="px-8 py-3 bg-gray-800 text-gray-300 font-bold rounded-xl border border-gray-600 hover:bg-gray-700 hover:text-white transition-all duration-150 text-lg">Annuler</button>
                    </div>
                    {{ form_end(savedCartForm) }}
                </form>
            </dialog>

            <script>
                                document.getElementById('share-cart-btn')?.addEventListener('click', function() {
                                    const token = '{{ cart.shareToken }}';
                                    if (token && token.length === 64) {
                                        const url = window.location.origin + '/cart/shared/' + token;
                                        navigator.clipboard.writeText(url).then(() => {
                                            const msg = document.getElementById('share-cart-msg');
                                            msg.classList.remove('hidden');
                                            setTimeout(() => msg.classList.add('hidden'), 2000);
                                        });
                                    } else {
                                        alert('Impossible de copier le lien');
                                    }
                                });
                document.getElementById('import-form').onsubmit = function(e) {
                    e.preventDefault();
                    let token = document.getElementById('import-token').value.trim();
                    const match = token.match(/([a-f0-9]{64})$/);
                    if (match) {
                        token = match[1];
                    }
                    if (token.length === 64) {
                        const form = e.target;
                        form.action = '/cart/import/' + token;
                        form.submit();
                    }
                };
            </script>
        </div>

        {% for message in app.flashes('success') %}
            <div class="mb-4 p-4 bg-green-600/20 border border-green-500 rounded-lg text-green-400">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="mb-4 p-4 bg-red-600/20 border border-red-500 rounded-lg text-red-400">
                {{ message }}
            </div>
        {% endfor %}

        {% if cart.items|length > 0 %}
            <div class="grid lg:grid-cols-3 gap-8">
                <div class="lg:col-span-2 space-y-4">
                    {% for item in cart.items %}
                        <div class="bg-gray-800 rounded-xl p-6 border border-gray-700 flex gap-6">
                            <div class="w-32 h-32 bg-gray-900 rounded-lg flex-shrink-0 overflow-hidden">
                                {% if item.product.photos is not empty %}
                                    <img src="{{ item.product.photos[0] }}" alt="{{ item.product.name }}" class="w-full h-full object-cover">
                                {% else %}
                                    <div class="w-full h-full flex items-center justify-center">
                                        <svg class="w-16 h-16 text-gray-700" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"></path>
                                        </svg>
                                    </div>
                                {% endif %}
                            </div>

                            <div class="flex-1">
                                <div class="flex justify-between items-start mb-2">
                                    <div>
                                        <h3 class="text-xl font-bold text-white mb-1">{{ item.product.name }}</h3>
                                        <p class="text-gray-400 text-sm capitalize">{{ item.product.category }} • {{ item.product.brand }}</p>
                                    </div>
                                    <form method="post" action="{{ path('app_cart_remove', {id: item.product.id}) }}">
                                        <button type="submit" class="text-red-400 hover:text-red-300 transition">
                                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                            </svg>
                                        </button>
                                    </form>
                                </div>

                                <div class="flex items-center justify-between mt-4">
                                    <div class="flex items-center gap-2">
                                        <form method="post" action="{{ path('app_cart_update', {id: item.product.id}) }}" class="inline">
                                            <input type="hidden" name="quantity" value="{{ item.quantity - 1 }}">
                                            <button type="submit" class="w-8 h-8 bg-gray-700 hover:bg-gray-600 text-white rounded-lg">-</button>
                                        </form>
                                        <span class="text-white font-semibold w-12 text-center">{{ item.quantity }}</span>
                                        <form method="post" action="{{ path('app_cart_update', {id: item.product.id}) }}" class="inline">
                                            <input type="hidden" name="quantity" value="{{ item.quantity + 1 }}">
                                            <button type="submit" class="w-8 h-8 bg-gray-700 hover:bg-gray-600 text-white rounded-lg" {% if item.quantity >= item.product.stock %}disabled{% endif %}>+</button>
                                        </form>
                                    </div>

                                    <div class="text-right">
                                        <div class="text-sm text-gray-400">{{ item.product.price }}€ × {{ item.quantity }}</div>
                                        <div class="text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600">
                                            {{ item.subtotal|number_format(2, '.', '') }}€
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}

                    <form method="post" action="{{ path('app_cart_clear') }}" class="text-center">
                        <button type="submit" class="text-red-400 hover:text-red-300 transition">
                             Vider le panier
                        </button>
                    </form>
                </div>

                <div class="lg:col-span-1">
                    <div class="bg-gray-800 rounded-xl p-6 border border-gray-700 sticky top-24">
                        <h2 class="text-2xl font-bold text-white mb-6">Résumé</h2>

                        <div class="space-y-3 mb-6">
                            <div class="flex justify-between text-gray-400">
                                <span>Sous-total ({{ cart.totalItems }} articles)</span>
                                <span class="text-white">{{ cart.total|number_format(2, '.', '') }}€</span>
                            </div>
                            <div class="flex justify-between text-gray-400">
                                <span>Livraison</span>
                                <span class="text-green-400">Gratuite</span>
                            </div>
                            <div class="border-t border-gray-700 pt-3 flex justify-between">
                                <span class="text-xl font-bold text-white">Total</span>
                                <span class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600">
                                    {{ cart.total|number_format(2, '.', '') }}€
                                </span>
                            </div>
                        </div>

                        <form method="post" action="{{ path('app_checkout_create_session') }}">
                            <button type="submit" class="w-full py-4 bg-gradient-to-r from-purple-600 to-pink-600 text-white text-lg font-bold rounded-xl hover:opacity-90 transition mb-3 flex items-center justify-center gap-2">
                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"></path>
                                </svg>
                                Payer
                            </button>
                        </form>

                        {% if cart.items|length > 0 and cart.shareToken is defined and cart.shareToken %}
                        <button type="button" id="share-cart-btn" class="block w-full py-3 bg-green-600 text-white text-center rounded-xl hover:bg-green-700 transition mb-3">Partager mon panier</button>
                        <span id="share-cart-msg" class="hidden text-green-400 text-sm mb-2">Lien copié !</span>
                        {% endif %}

                        <button onclick="document.getElementById('save-cart-modal').showModal()" class="block w-full py-3 bg-blue-600 text-white text-center rounded-xl hover:bg-blue-700 transition mb-3">Enregistrer le panier</button>

                        <a href="{{ path('app_catalogue') }}" class="block w-full py-3 bg-gray-700 hover:bg-gray-600 text-white text-center rounded-xl transition">
                            Continuer mes achats
                        </a>
                    </div>
                </div>
            </div>
        {% else %}

            <div class="text-center py-20">
                <h2 class="text-3xl font-bold text-white mb-4">Votre panier est vide</h2>
                <p class="text-gray-400 mb-8">Découvrez notre sélection de produits gaming</p>
                <a href="{{ path('app_catalogue') }}" class="inline-block px-8 py-4 bg-gradient-to-r from-purple-600 to-pink-600 text-white text-lg font-bold rounded-xl hover:opacity-90 transition">
                    Voir le catalogue
                </a>
            </div>
        {% endif %}
    </div>

    {{ include('components/_footer.html.twig') }}
</div>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const shareBtn = document.getElementById('share-cart-btn');
    if (shareBtn) {
        shareBtn.addEventListener('click', function() {
            const token = '{{ cart.shareToken }}';
            if (token && token.length === 64) {
                const url = window.location.origin + '/cart/shared/' + token;
                navigator.clipboard.writeText(url).then(() => {
                    const msg = document.getElementById('share-cart-msg');
                    msg.classList.remove('hidden');
                    setTimeout(() => msg.classList.add('hidden'), 2000);
                });
            } else {
                alert('Impossible de copier le lien');
            }
        });
    }
});
</script>
</div>
{% endblock %}
