{% extends 'base.html.twig' %}

{% block title %}Mon Panier - GearForge{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-b from-gray-900 to-gray-800">
    {{ include('components/_navbar.html.twig') }}

    <div class="container mx-auto px-4 py-8">
        <div class="text-center mb-12">
            <h1 class="text-5xl font-bold text-white mb-4">
                Mon <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600">Panier</span>
            </h1>
        </div>

        {% for message in app.flashes('success') %}
            <div class="mb-4 p-4 bg-green-600/20 border border-green-500 rounded-lg text-green-400">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <div class="mb-4 p-4 bg-red-600/20 border border-red-500 rounded-lg text-red-400">
                {{ message }}
            </div>
        {% endfor %}

        {% if cart.items|length > 0 %}
            <div class="grid lg:grid-cols-3 gap-8">
                <div class="lg:col-span-2 space-y-4">
                    {% for item in cart.items %}
                        <div class="bg-gray-800 rounded-xl p-6 border border-gray-700 flex gap-6">
                            <div class="w-32 h-32 bg-gray-900 rounded-lg flex-shrink-0 overflow-hidden">
                                {% if item.product.photos is not empty %}
                                    <img src="{{ item.product.photos[0] }}" alt="{{ item.product.name }}" class="w-full h-full object-cover">
                                {% else %}
                                    <div class="w-full h-full flex items-center justify-center">
                                        <svg class="w-16 h-16 text-gray-700" fill="currentColor" viewBox="0 0 20 20">
                                            <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"></path>
                                        </svg>
                                    </div>
                                {% endif %}
                            </div>

                            <div class="flex-1">
                                <div class="flex justify-between items-start mb-2">
                                    <div>
                                        <h3 class="text-xl font-bold text-white mb-1">{{ item.product.name }}</h3>
                                        <p class="text-gray-400 text-sm capitalize">{{ item.product.category }} • {{ item.product.brand }}</p>
                                    </div>
                                    <form method="post" action="{{ path('app_cart_remove', {id: item.product.id}) }}">
                                        <button type="submit" class="text-red-400 hover:text-red-300 transition">
                                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                            </svg>
                                        </button>
                                    </form>
                                </div>

                                <div class="flex items-center justify-between mt-4">
                                    <div class="flex items-center gap-2">
                                        <form method="post" action="{{ path('app_cart_update', {id: item.product.id}) }}" class="inline">
                                            <input type="hidden" name="quantity" value="{{ item.quantity - 1 }}">
                                            <button type="submit" class="w-8 h-8 bg-gray-700 hover:bg-gray-600 text-white rounded-lg">-</button>
                                        </form>
                                        <span class="text-white font-semibold w-12 text-center">{{ item.quantity }}</span>
                                        <form method="post" action="{{ path('app_cart_update', {id: item.product.id}) }}" class="inline">
                                            <input type="hidden" name="quantity" value="{{ item.quantity + 1 }}">
                                            <button type="submit" class="w-8 h-8 bg-gray-700 hover:bg-gray-600 text-white rounded-lg" {% if item.quantity >= item.product.stock %}disabled{% endif %}>+</button>
                                        </form>
                                    </div>

                                    <div class="text-right">
                                        <div class="text-sm text-gray-400">{{ item.product.price }}€ × {{ item.quantity }}</div>
                                        <div class="text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600">
                                            {{ item.subtotal|number_format(2, '.', '') }}€
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}

                    <form method="post" action="{{ path('app_cart_clear') }}" class="text-center">
                        <button type="submit" class="text-red-400 hover:text-red-300 transition">
                             Vider le panier
                        </button>
                    </form>
                </div>

                <div class="lg:col-span-1">
                    <div class="bg-gray-800 rounded-xl p-6 border border-gray-700 sticky top-24">
                        <h2 class="text-2xl font-bold text-white mb-6">Résumé</h2>

                        <div class="space-y-3 mb-6">
                            <div class="flex justify-between text-gray-400">
                                <span>Sous-total ({{ cart.totalItems }} articles)</span>
                                <span class="text-white">{{ cart.total|number_format(2, '.', '') }}€</span>
                            </div>
                            <div class="flex justify-between text-gray-400">
                                <span>Livraison</span>
                                <span class="text-green-400">Gratuite</span>
                            </div>
                            <div class="border-t border-gray-700 pt-3 flex justify-between">
                                <span class="text-xl font-bold text-white">Total</span>
                                <span class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600">
                                    {{ cart.total|number_format(2, '.', '') }}€
                                </span>
                            </div>
                        </div>

                        <button class="w-full py-4 bg-gradient-to-r from-purple-600 to-pink-600 text-white text-lg font-bold rounded-xl hover:opacity-90 transition mb-3">
                            Passer la commande
                        </button>

                        <a href="{{ path('app_catalogue') }}" class="block w-full py-3 bg-gray-700 hover:bg-gray-600 text-white text-center rounded-xl transition">
                            Continuer mes achats
                        </a>
                    </div>
                </div>
            </div>
        {% else %}

            <div class="text-center py-20">
                <h2 class="text-3xl font-bold text-white mb-4">Votre panier est vide</h2>
                <p class="text-gray-400 mb-8">Découvrez notre sélection de produits gaming</p>
                <a href="{{ path('app_catalogue') }}" class="inline-block px-8 py-4 bg-gradient-to-r from-purple-600 to-pink-600 text-white text-lg font-bold rounded-xl hover:opacity-90 transition">
                    Voir le catalogue
                </a>
            </div>
        {% endif %}
    </div>

    {{ include('components/_footer.html.twig') }}
</div>
{% endblock %}
