{% extends 'base.html.twig' %}

{% block title %}Panier - GearForge{% endblock %}

{% block body %}
<div class="relative isolate overflow-x-hidden" style="font-family:var(--font-pixel), sans-serif;">

  <div class="pointer-events-none fixed inset-0 -z-10"
       style="background:
         linear-gradient(180deg, rgba(18,10,46,0.97), rgba(11,7,32,1)),
         linear-gradient(90deg, rgba(233,221,255,0.07) 1px, transparent 1px),
         linear-gradient(0deg,  rgba(233,221,255,0.07) 1px, transparent 1px),
         repeating-linear-gradient(45deg, rgba(233,221,255,0.05) 0 2px, rgba(0,0,0,0) 2px 5px);
         background-size: auto, 5px 5px, 5px 5px, auto;">
  </div>

  <div class="container mx-auto px-6 pt-12 pb-20">

    <div class="mb-10 flex flex-col items-center gap-3 text-center">
      <p class="text-[8px] tracking-[0.4em]" style="color:var(--secondary);">VOTRE SÉLECTION</p>
      <h1 class="text-xl md:text-2xl tracking-widest" style="color:var(--pixel-head); text-shadow:3px 3px 0 var(--pixel-shadow);">MON PANIER</h1>
      <div class="h-[2px] w-24 rounded-full" style="background:linear-gradient(90deg,var(--color-mauve-500),var(--tertiary));"></div>
      <button onclick="document.getElementById('import-modal').showModal()"
              class="mt-2 text-[8px] tracking-widest px-4 py-2 border border-white/10 rounded"
              style="color:rgba(233,221,255,0.50); background:rgba(18,10,46,0.5); transition:color 120ms,border-color 120ms;"
              onmouseover="this.style.color='var(--pixel-border)'; this.style.borderColor='rgba(233,221,255,0.30)'"
              onmouseout="this.style.color='rgba(233,221,255,0.50)'; this.style.borderColor='rgba(255,255,255,0.10)'">
        IMPORTER UN PANIER
      </button>
    </div>

    {% for message in app.flashes('success') %}
      <div class="detail-flash detail-flash--success mb-5">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
      <div class="detail-flash detail-flash--error mb-5">{{ message }}</div>
    {% endfor %}

    {% if cart.items|length > 0 %}
      <div class="grid lg:grid-cols-3 gap-8">

        <div class="lg:col-span-2 flex flex-col gap-4">
          {% for item in cart.items %}
            <div class="cart-item">
              <div class="cart-item__img">
                {% if item.product.photos is not empty %}
                  <img src="{{ item.product.photos[0] }}" alt="{{ item.product.name }}" class="w-full h-full object-cover">
                {% else %}
                  <div class="w-full h-full flex items-center justify-center">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" style="color:rgba(233,221,255,0.15);">
                      <rect x="3" y="3" width="18" height="18" rx="2"/><path d="m3 9 4-4 4 4 4-4 4 4"/><circle cx="8.5" cy="13.5" r="1.5"/>
                    </svg>
                  </div>
                {% endif %}
              </div>

              <div class="flex-1 flex flex-col gap-3 min-w-0">
                <div class="flex justify-between items-start gap-3">
                  <div class="min-w-0">
                    <h3 class="cart-item__name">{{ item.product.name }}</h3>
                    <p class="cart-item__meta">{{ item.product.category|upper }} · {{ item.product.brand|upper }}</p>
                  </div>
                  <form method="post" action="{{ path('app_cart_remove', {id: item.product.id}) }}">
                    <button type="submit" class="cart-item__remove" title="Retirer">
                      <span class="css-close" aria-hidden="true"></span>
                    </button>
                  </form>
                </div>

                <div class="flex items-center justify-between flex-wrap gap-4">
                  <div class="flex items-center gap-2">
                    <form method="post" action="{{ path('app_cart_update', {id: item.product.id}) }}">
                      <input type="hidden" name="quantity" value="{{ item.quantity - 1 }}">
                      <button type="submit" class="cart-qty__btn">−</button>
                    </form>
                    <span class="cart-qty__val">{{ item.quantity }}</span>
                    <form method="post" action="{{ path('app_cart_update', {id: item.product.id}) }}">
                      <input type="hidden" name="quantity" value="{{ item.quantity + 1 }}">
                      <button type="submit" class="cart-qty__btn" {% if item.quantity >= item.product.stock %}disabled{% endif %}>+</button>
                    </form>
                  </div>
                  <div class="text-right">
                    <div class="text-[8px] tracking-wider mb-1" style="color:rgba(233,221,255,0.40);">
                      {{ item.product.price }}€ × {{ item.quantity }}
                    </div>
                    <div class="text-[15px] tracking-wide" style="color:var(--pixel-head); text-shadow:2px 2px 0 var(--pixel-shadow);">
                      {{ item.subtotal|number_format(2, '.', '') }}€
                    </div>
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}

          <form method="post" action="{{ path('app_cart_clear') }}" class="flex justify-end mt-2">
            <button type="submit" class="text-[8px] tracking-widest px-4 py-2 border rounded transition"
                    style="color:rgba(239,68,68,0.60); border-color:rgba(239,68,68,0.20); background:rgba(239,68,68,0.05);"
                    onmouseover="this.style.color='#fca5a5'; this.style.borderColor='rgba(239,68,68,0.50)'"
                    onmouseout="this.style.color='rgba(239,68,68,0.60)'; this.style.borderColor='rgba(239,68,68,0.20)'">
              VIDER LE PANIER
            </button>
          </form>
        </div>

        <div class="lg:col-span-1">
          <div class="detail-panel detail-panel--flush" style="position:sticky; top:88px;">
            <div class="ds-panel__top">
              <span class="ds-label">RÉSUMÉ</span>
            </div>
            <div class="p-5 flex flex-col gap-4">
              <div class="flex flex-col gap-3 pb-4 border-b" style="border-color:rgba(233,221,255,0.08);">
                <div class="flex justify-between items-center">
                  <span class="text-[8px] tracking-wider" style="color:rgba(233,221,255,0.45);">ARTICLES ({{ cart.totalItems }})</span>
                  <span class="text-[9px]" style="color:var(--pixel-border);">{{ cart.total|number_format(2, '.', '') }}€</span>
                </div>
                <div class="flex justify-between items-center">
                  <span class="text-[8px] tracking-wider" style="color:rgba(233,221,255,0.45);">LIVRAISON</span>
                  <span class="text-[9px]" style="color:#86efac;">GRATUITE</span>
                </div>
              </div>
              <div class="flex justify-between items-end">
                <span class="text-[9px] tracking-widest" style="color:var(--pixel-border);">TOTAL</span>
                <span class="text-[20px] tracking-wide" style="color:var(--pixel-head); text-shadow:3px 3px 0 var(--pixel-shadow);">
                  {{ cart.total|number_format(2, '.', '') }}€
                </span>
              </div>

              <form method="post" action="{{ path('app_checkout_create_session') }}" class="mt-2">
                <button type="submit" class="pixel-btn is-cta" style="width:100%; justify-content:center;">
                  <span class="pixel-btn__text">PAYER</span>
                  <span class="pixel-btn__arrow"><span class="css-arrow-right" aria-hidden="true"></span></span>
                </button>
              </form>

              {% if cart.items|length > 0 and cart.shareToken is defined and cart.shareToken %}
                <button type="button" id="share-cart-btn" class="cart-action-btn">PARTAGER LE PANIER</button>
                <span id="share-cart-msg" class="hidden text-[8px] tracking-widest text-center" style="color:#86efac;">LIEN COPIÉ !</span>
              {% endif %}

              <button onclick="document.getElementById('save-cart-modal').showModal()" class="cart-action-btn">ENREGISTRER LE PANIER</button>

              <a href="{{ path('app_catalogue') }}" class="cart-action-btn" style="text-decoration:none; text-align:center;">CONTINUER MES ACHATS</a>
            </div>
          </div>
        </div>
      </div>

    {% else %}
      <div class="detail-panel flex flex-col items-center gap-6 py-16 text-center">
        <svg width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" style="color:rgba(233,221,255,0.12);">
          <path d="M6 2 3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/>
        </svg>
        <div>
          <p class="text-[10px] tracking-widest mb-3" style="color:var(--pixel-head);">PANIER VIDE</p>
          <p class="text-[9px] tracking-wide" style="color:rgba(233,221,255,0.40);">Découvrez notre sélection de produits gaming.</p>
        </div>
        <a href="{{ path('app_catalogue') }}" class="pixel-btn is-cta" style="width:auto; min-width:180px; text-decoration:none; justify-content:center;">
          <span class="pixel-btn__text">VOIR LE CATALOGUE</span>
          <span class="pixel-btn__arrow"><span class="css-arrow-right" aria-hidden="true"></span></span>
        </a>
      </div>
    {% endif %}

  </div>

  <dialog id="import-modal" class="cart-modal">
    <form method="post" action="" id="import-form" class="cart-modal__inner">
      <div class="ds-panel__top">
        <span class="ds-label">IMPORTER UN PANIER</span>
        <button type="button" onclick="document.getElementById('import-modal').close()" class="cart-item__remove">
          <span class="css-close" aria-hidden="true"></span>
        </button>
      </div>
      <div class="p-6 flex flex-col gap-5">
        <label class="detail-form__label" for="import-token">TOKEN DE PARTAGE</label>
        <input type="text" id="import-token" name="token"
               class="detail-form__textarea"
               style="font-family:var(--font-ui),sans-serif; font-size:12px; resize:none; text-align:center;"
               placeholder="Colle ici le token..." autocomplete="off" required>
        <div class="flex gap-3 justify-end">
          <button type="button" onclick="document.getElementById('import-modal').close()" class="cart-action-btn">ANNULER</button>
          <button type="submit" class="pixel-btn is-cta" style="width:auto; min-width:120px; justify-content:center;">
            <span class="pixel-btn__text">IMPORTER</span>
          </button>
        </div>
      </div>
    </form>
  </dialog>

  <dialog id="save-cart-modal" class="cart-modal">
    <form method="post" action="/cart/save" class="cart-modal__inner">
      <div class="ds-panel__top">
        <span class="ds-label">ENREGISTRER LE PANIER</span>
        <button type="button" onclick="document.getElementById('save-cart-modal').close()" class="cart-item__remove">
          <span class="css-close" aria-hidden="true"></span>
        </button>
      </div>
      {{ form_start(savedCartForm) }}
      <div class="p-6 flex flex-col gap-5">
        <label class="detail-form__label" for="saved_cart_name">NOM DU PANIER</label>
        {{ form_widget(savedCartForm.name, {attr: {class: 'detail-form__textarea', style: 'resize:none; font-family:var(--font-ui),sans-serif;'}}) }}
        <div class="flex gap-3 justify-end">
          <button type="button" onclick="document.getElementById('save-cart-modal').close()" class="cart-action-btn">ANNULER</button>
          <button type="submit" class="pixel-btn is-cta" style="width:auto; min-width:140px; justify-content:center;">
            <span class="pixel-btn__text">ENREGISTRER</span>
          </button>
        </div>
      </div>
      {{ form_end(savedCartForm) }}
    </form>
  </dialog>

  {{ include('components/_footer.html.twig') }}
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const shareBtn = document.getElementById('share-cart-btn');
  if (shareBtn) {
    shareBtn.addEventListener('click', function () {
      const token = '{{ cart.shareToken }}';
      if (token && token.length === 64) {
        navigator.clipboard.writeText(window.location.origin + '/cart/shared/' + token).then(() => {
          const msg = document.getElementById('share-cart-msg');
          msg.classList.remove('hidden');
          setTimeout(() => msg.classList.add('hidden'), 2000);
        });
      }
    });
  }
  document.getElementById('import-form').onsubmit = function (e) {
    e.preventDefault();
    let token = document.getElementById('import-token').value.trim();
    const match = token.match(/([a-f0-9]{64})$/);
    if (match) token = match[1];
    if (token.length === 64) { e.target.action = '/cart/import/' + token; e.target.submit(); }
  };
});
</script>
{% endblock %}