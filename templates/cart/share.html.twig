{% extends 'base.html.twig' %}

{% block title %}Partager mon panier{% endblock %}

{% block body %}
<div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold mb-4">Partager mon panier</h1>
    <div class="mb-4">
        <label class="block text-gray-700">Lien de partage :</label>
        <input type="text" readonly value="{{ shareUrl }}" class="w-full p-2 border rounded bg-gray-100 text-gray-800" onclick="this.select();document.execCommand('copy');">
        <small class="text-gray-500">Copiez ce lien pour partager votre panier avec quelqu'un.</small>
    </div>
    <a href="{{ path('app_cart') }}" class="inline-block mt-4 px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">Retour au panier</a>
</div>
{% endblock %}
