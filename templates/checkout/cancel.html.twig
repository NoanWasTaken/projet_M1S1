{% extends 'base.html.twig' %}

{% block title %}Paiement annulé - GearForge{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-b from-gray-900 to-gray-800">
    <!-- Header -->
    <header class="bg-gray-900/50 backdrop-blur-sm border-b border-gray-700">
        <div class="container mx-auto px-4 py-4">
            <div class="flex items-center justify-between">
                <a href="{{ path('app_home') }}" class="text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600">
                    GearForge
                </a>
                <nav class="hidden md:flex items-center space-x-6">
                    <a href="{{ path('app_catalogue') }}" class="text-gray-300 hover:text-white transition">Catalogue</a>
                    {% if app.user %}
                        <a href="{{ path('app_cart') }}" class="relative text-gray-300 hover:text-white transition">
                            <span>Panier</span>
                        </a>
                        <span class="text-gray-400">{{ app.user.email }}</span>
                        <a href="{{ path('app_logout') }}" class="text-gray-300 hover:text-white transition">Déconnexion</a>
                    {% endif %}
                </nav>
            </div>
        </div>
    </header>

    <div class="container mx-auto px-4 py-20">
        <div class="max-w-2xl mx-auto text-center">
            <div class="mb-8 flex justify-center">
                <div class="w-32 h-32 bg-gradient-to-r from-orange-600 to-red-600 rounded-full flex items-center justify-center">
                    <svg class="w-16 h-16 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </div>
            </div>

            <h1 class="text-5xl font-bold text-white mb-4">
                Paiement <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-400 to-red-600">Annulé</span>
            </h1>
            
            <p class="text-xl text-gray-300 mb-8">
                Votre paiement a été annulé. Vos articles sont toujours dans votre panier.
            </p>

            <div class="bg-gray-800 rounded-xl p-8 border border-gray-700 mb-8">
                <div class="flex items-center justify-center gap-4 text-gray-400">
                    <svg class="w-8 h-8 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                    </svg>
                    <div class="text-left">
                        <p class="text-white font-semibold text-lg">Aucun montant n'a été débité</p>
                        <p class="text-sm">Vous pouvez réessayer quand vous le souhaitez</p>
                    </div>
                </div>
            </div>

            <div class="space-y-4">
                <a href="{{ path('app_cart') }}" class="block w-full py-4 bg-gradient-to-r from-purple-600 to-pink-600 text-white text-lg font-bold rounded-xl hover:opacity-90 transition flex items-center justify-center gap-2">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
                    </svg>
                    Retour au panier
                </a>
                <a href="{{ path('app_catalogue') }}" class="block w-full py-4 bg-gray-700 hover:bg-gray-600 text-white text-lg font-bold rounded-xl transition">
                    Continuer mes achats
                </a>
            </div>

            <div class="mt-12 p-6 bg-gray-800/50 rounded-lg border border-gray-700">
                <h3 class="text-xl font-bold text-white mb-4">Besoin d'aide ?</h3>
                <p class="text-gray-400 mb-4">
                    Si vous avez rencontré un problème lors du paiement, n'hésitez pas à nous contacter.
                </p>
                <div class="flex flex-wrap gap-4 justify-center">
                    <a href="#" class="inline-flex items-center gap-2 px-6 py-3 bg-gray-700 hover:bg-gray-600 text-white rounded-lg transition">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                        </svg>
                        Nous contacter
                    </a>
                    <a href="#" class="inline-flex items-center gap-2 px-6 py-3 bg-gray-700 hover:bg-gray-600 text-white rounded-lg transition">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        FAQ
                    </a>
                </div>
            </div>
        </div>
    </div>

    <footer class="bg-gray-900 border-t border-gray-800 mt-20 py-12">
        <div class="container mx-auto px-4 text-center">
            <p class="text-gray-400">&copy; 2026 GearForge. Tous droits réservés.</p>
        </div>
    </footer>
</div>
{% endblock %}
