{% extends 'base.html.twig' %}

{% block title %}Paiement annulé - GearForge{% endblock %}

{% block body %}
<div class="relative isolate overflow-x-hidden" style="font-family:var(--font-pixel), sans-serif;">

  <div class="pointer-events-none fixed inset-0 -z-10"
       style="background:
         linear-gradient(180deg, rgba(18,10,46,0.97), rgba(11,7,32,1)),
         linear-gradient(90deg, rgba(233,221,255,0.07) 1px, transparent 1px),
         linear-gradient(0deg,  rgba(233,221,255,0.07) 1px, transparent 1px),
         repeating-linear-gradient(45deg, rgba(233,221,255,0.05) 0 2px, rgba(0,0,0,0) 2px 5px);
         background-size: auto, 5px 5px, 5px 5px, auto;">
  </div>

  <div class="container mx-auto px-6 pt-16 pb-24">
    <div class="max-w-xl mx-auto flex flex-col items-center gap-8 text-center">

      <div class="w-24 h-24 rounded-full flex items-center justify-center" style="background:rgba(249,115,22,0.12); border:2px solid rgba(249,115,22,0.30);">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#fdba74" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 9v4m0 4h.01M10.29 3.86 1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
        </svg>
      </div>

      <div class="flex flex-col gap-3">
        <p class="text-[8px] tracking-[0.4em]" style="color:var(--secondary);">PAIEMENT</p>
        <h1 class="text-xl md:text-2xl tracking-widest" style="color:#fdba74; text-shadow:3px 3px 0 var(--pixel-shadow);">COMMANDE ANNULÉE</h1>
        <div class="h-[2px] w-24 mx-auto rounded-full" style="background:linear-gradient(90deg, #f97316, var(--color-mauve-500));"></div>
        <p style="font-family:var(--font-ui),sans-serif; font-size:13px; line-height:1.7; color:rgba(233,221,255,0.55);">Votre paiement a été annulé. Vos articles sont toujours dans votre panier.</p>
      </div>

      <div class="detail-panel detail-panel--flush w-full">
        <div class="ds-panel__top">
          <span class="ds-label">AUCUN MONTANT DÉBITÉ</span>
        </div>
        <div class="p-5">
          <p style="font-family:var(--font-ui),sans-serif; font-size:13px; line-height:1.7; color:rgba(233,221,255,0.55);">Vous pouvez réessayer quand vous le souhaitez ou nous contacter si vous avez rencontré un problème.</p>
        </div>
      </div>

      <div class="flex flex-col gap-3 w-full">
        <a href="{{ path('app_cart') }}" class="pixel-btn is-cta" style="width:100%; justify-content:center; text-decoration:none;">
          <span class="pixel-btn__text">RETOUR AU PANIER</span>
          <span class="pixel-btn__arrow"><span class="css-arrow-right" aria-hidden="true"></span></span>
        </a>
        <a href="{{ path('app_catalogue') }}" class="cart-action-btn" style="text-decoration:none;">CONTINUER MES ACHATS</a>
      </div>

    </div>
  </div>

  {{ include('components/_footer.html.twig') }}
</div>
{% endblock %}
