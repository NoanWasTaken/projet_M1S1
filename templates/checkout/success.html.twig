{% extends 'base.html.twig' %}

{% block title %}Paiement réussi - GearForge{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-b from-gray-900 to-gray-800">
    <!-- Header -->
    <header class="bg-gray-900/50 backdrop-blur-sm border-b border-gray-700">
        <div class="container mx-auto px-4 py-4">
            <div class="flex items-center justify-between">
                <a href="{{ path('app_home') }}" class="text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600">
                    GearForge
                </a>
                <nav class="hidden md:flex items-center space-x-6">
                    <a href="{{ path('app_catalogue') }}" class="text-gray-300 hover:text-white transition">Catalogue</a>
                    <a href="{{ path('app_cart') }}" class="relative text-gray-300 hover:text-white transition">
                        <span>Panier</span>
                    </a>
                    {% if app.user %}
                        <span class="text-gray-400">{{ app.user.email }}</span>
                        <a href="{{ path('app_logout') }}" class="text-gray-300 hover:text-white transition">Déconnexion</a>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="text-gray-300 hover:text-white transition">Connexion</a>
                    {% endif %}
                </nav>
            </div>
        </div>
    </header>

    <div class="container mx-auto px-4 py-20">
        <div class="max-w-2xl mx-auto text-center">
            <div class="mb-8 flex justify-center">
                <div class="relative">
                    <div class="w-32 h-32 bg-gradient-to-r from-green-600 to-emerald-600 rounded-full flex items-center justify-center animate-pulse">
                        <svg class="w-16 h-16 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                    </div>
                    <div class="absolute inset-0 bg-gradient-to-r from-green-600 to-emerald-600 rounded-full opacity-20 animate-ping"></div>
                </div>
            </div>

            <h1 class="text-5xl font-bold text-white mb-4">
                Paiement <span class="text-transparent bg-clip-text bg-gradient-to-r from-green-400 to-emerald-600">Réussi</span>!
            </h1>
            
            <p class="text-xl text-gray-300 mb-8">
                Merci pour votre commande ! Vous allez recevoir un email de confirmation.
            </p>

            <div class="bg-gray-800 rounded-xl p-8 border border-gray-700 mb-8">
                <div class="flex items-center justify-center gap-4 text-gray-400">
                    <svg class="w-8 h-8 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <div class="text-left">
                        <p class="text-white font-semibold text-lg">Votre commande est confirmée</p>
                        <p class="text-sm">Nous préparons votre colis avec soin</p>
                    </div>
                </div>
            </div>

            <div class="space-y-4">
                <a href="{{ path('app_catalogue') }}" class="block w-full py-4 bg-gradient-to-r from-purple-600 to-pink-600 text-white text-lg font-bold rounded-xl hover:opacity-90 transition">
                    Continuer mes achats
                </a>
                <a href="{{ path('app_home') }}" class="block w-full py-4 bg-gray-700 hover:bg-gray-600 text-white text-lg font-bold rounded-xl transition">
                    Retour à l'accueil
                </a>
            </div>

            <div class="mt-12 p-6 bg-gray-800/50 rounded-lg border border-gray-700">
                <h3 class="text-xl font-bold text-white mb-4">Que se passe-t-il maintenant ?</h3>
                <div class="grid gap-4 text-left">
                    <div class="flex gap-3">
                        <div class="flex-shrink-0">
                            <div class="w-8 h-8 bg-purple-600/20 rounded-full flex items-center justify-center">
                                <span class="text-purple-400 font-bold">1</span>
                            </div>
                        </div>
                        <div>
                            <p class="text-white font-semibold">Email de confirmation</p>
                            <p class="text-gray-400 text-sm">Vous recevrez un email avec les détails de votre commande</p>
                        </div>
                    </div>
                    <div class="flex gap-3">
                        <div class="flex-shrink-0">
                            <div class="w-8 h-8 bg-purple-600/20 rounded-full flex items-center justify-center">
                                <span class="text-purple-400 font-bold">2</span>
                            </div>
                        </div>
                        <div>
                            <p class="text-white font-semibold">Préparation</p>
                            <p class="text-gray-400 text-sm">Votre commande sera préparée sous 24-48h</p>
                        </div>
                    </div>
                    <div class="flex gap-3">
                        <div class="flex-shrink-0">
                            <div class="w-8 h-8 bg-purple-600/20 rounded-full flex items-center justify-center">
                                <span class="text-purple-400 font-bold">3</span>
                            </div>
                        </div>
                        <div>
                            <p class="text-white font-semibold">Expédition</p>
                            <p class="text-gray-400 text-sm">Livraison gratuite à votre domicile sous 3-5 jours ouvrés</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer class="bg-gray-900 border-t border-gray-800 mt-20 py-12">
        <div class="container mx-auto px-4 text-center">
            <p class="text-gray-400">&copy; 2026 GearForge. Tous droits réservés.</p>
        </div>
    </footer>
</div>
{% endblock %}
