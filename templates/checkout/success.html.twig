{% extends 'base.html.twig' %}

{% block title %}Paiement réussi - GearForge{% endblock %}

{% block body %}
<div class="relative isolate overflow-x-hidden" style="font-family:var(--font-pixel), sans-serif;">

  <div class="pointer-events-none fixed inset-0 -z-10"
       style="background:
         linear-gradient(180deg, rgba(18,10,46,0.97), rgba(11,7,32,1)),
         linear-gradient(90deg, rgba(233,221,255,0.07) 1px, transparent 1px),
         linear-gradient(0deg,  rgba(233,221,255,0.07) 1px, transparent 1px),
         repeating-linear-gradient(45deg, rgba(233,221,255,0.05) 0 2px, rgba(0,0,0,0) 2px 5px);
         background-size: auto, 5px 5px, 5px 5px, auto;">
  </div>

  <div class="container mx-auto px-6 pt-16 pb-24">
    <div class="max-w-xl mx-auto flex flex-col items-center gap-8 text-center">

      <div class="relative flex items-center justify-center">
        <div class="w-24 h-24 rounded-full flex items-center justify-center" style="background:rgba(34,197,94,0.15); border:2px solid rgba(34,197,94,0.35);">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#86efac" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 13l4 4L19 7"/>
          </svg>
        </div>
        <div class="absolute inset-0 rounded-full animate-ping" style="background:rgba(34,197,94,0.08);"></div>
      </div>

      <div class="flex flex-col gap-3">
        <p class="text-[8px] tracking-[0.4em]" style="color:var(--secondary);">CONFIRMATION</p>
        <h1 class="text-xl md:text-2xl tracking-widest" style="color:#86efac; text-shadow:3px 3px 0 var(--pixel-shadow);">PAIEMENT RÉUSSI</h1>
        <div class="h-[2px] w-24 mx-auto rounded-full" style="background:linear-gradient(90deg, #22c55e, var(--tertiary));"></div>
        <p style="font-family:var(--font-ui),sans-serif; font-size:13px; line-height:1.7; color:rgba(233,221,255,0.55);">Merci pour votre commande&nbsp;! Vous allez recevoir un email de confirmation.</p>
      </div>

      <div class="detail-panel detail-panel--flush w-full">
        <div class="ds-panel__top">
          <span class="ds-label">VOTRE COMMANDE EST CONFIRMÉE</span>
        </div>
        <div class="p-5 flex flex-col gap-4">
          <div class="flex items-start gap-4">
            <span class="checkout-step__num">1</span>
            <div class="text-left">
              <p class="text-[9px] tracking-widest mb-1" style="color:var(--pixel-head);">EMAIL DE CONFIRMATION</p>
              <p style="font-family:var(--font-ui),sans-serif; font-size:12px; color:rgba(233,221,255,0.50);">Vous recevrez un email avec les détails de votre commande.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <span class="checkout-step__num">2</span>
            <div class="text-left">
              <p class="text-[9px] tracking-widest mb-1" style="color:var(--pixel-head);">PRÉPARATION</p>
              <p style="font-family:var(--font-ui),sans-serif; font-size:12px; color:rgba(233,221,255,0.50);">Votre commande sera préparée sous 24-48h.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <span class="checkout-step__num">3</span>
            <div class="text-left">
              <p class="text-[9px] tracking-widest mb-1" style="color:var(--pixel-head);">EXPÉDITION</p>
              <p style="font-family:var(--font-ui),sans-serif; font-size:12px; color:rgba(233,221,255,0.50);">Livraison gratuite à votre domicile sous 3-5 jours ouvrés.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="flex flex-col gap-3 w-full">
        <a href="{{ path('app_catalogue') }}" class="pixel-btn is-cta" style="width:100%; justify-content:center; text-decoration:none;">
          <span class="pixel-btn__text">CONTINUER MES ACHATS</span>
          <span class="pixel-btn__arrow"><span class="css-arrow-right" aria-hidden="true"></span></span>
        </a>
        <a href="{{ path('app_home') }}" class="cart-action-btn" style="text-decoration:none;">RETOUR À L'ACCUEIL</a>
      </div>

    </div>
  </div>

  {{ include('components/_footer.html.twig') }}
</div>
{% endblock %}
