<header class="pixel-header fixed top-0 left-0 right-0 z-40 lg:static">
  <section class="container mx-auto px-4 py-4 pixel-ui">
    <section class="relative flex items-center justify-between">

      <div class="flex items-center">
        <button type="button" data-sidebar-toggle data-action="click->sidebar#toggle" aria-expanded="false" class="pixel-icon-btn" aria-label="Ouvrir le menu">
          <span class="css-hamburger" aria-hidden="true"><span></span><span></span><span></span></span>
        </button>
      </div>

      <div class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2">
        <a href="{{ path('app_home') }}" class="pixel-brand pointer-events-auto">
          <span class="pixel-brand__main">GEARFORGE</span>
        </a>
      </div>

      <nav class="hidden md:flex items-center gap-3">
        {#<a href="{{ path('app_catalogue') }}" faire une barre de recherche à la place
           class="pixel-icon-link"
           data-tip="Catalogue"
           aria-label="Catalogue">
          <i data-lucide="shopping-bag" class="w-5 h-5"></i>
        </a>#}

        <a href="{{ path('app_cart') }}"
           class="pixel-icon-link pixel-icon-link--cta relative"
           data-tip="Panier"
           aria-label="Panier">
          <span class="relative block">
            <i data-lucide="shopping-cart" class="w-5 h-5"></i>
            {% if cart is defined and cart.totalItems is defined and cart.totalItems > 0 %}
              <span class="absolute top-0 right-0 transform translate-x-1/2 -translate-y-1/2 inline-flex items-center justify-center px-2 py-0.5 text-xs font-semibold leading-none text-white bg-pink-600 rounded-full shadow-lg">
                {{ cart.totalItems }}
              </span>
            {% endif %}
          </span>
        </a>

        {% if app.user %}
          {% if is_granted('ROLE_MODERATOR') %}
            <a href="{{ path('admin') }}"
              class="pixel-icon-link text-gray-300 hover:text-white"
              data-tip="Administration"
              aria-label="Administration">
              <i data-lucide="shield" class="w-5 h-5"></i>
            </a>
          {% endif %}
            <a href="{{ path('app_client_profile') }}"
              class="pixel-icon-chip"
              data-tip="Profil ({{ app.user.email }})"
              aria-label="Profil">
              <i data-lucide="user" class="w-5 h-5"></i>
            </a>
          <a href="{{ path('app_logout') }}"
             class="pixel-icon-link"
             data-tip="Déconnexion"
             aria-label="Déconnexion">
            <i data-lucide="log-out" class="w-5 h-5"></i>
          </a>
        {% else %}
          <a href="{{ path('app_login') }}"
             class="pixel-icon-link"
             data-tip="Connexion"
             aria-label="Connexion">
            <i data-lucide="log-in" class="w-5 h-5"></i>
          </a>
        {% endif %}
      </nav>

    </section>
  </section>
</header>