<header class="bg-gray-900/50 backdrop-blur-sm border-b border-gray-700{% if sticky is not defined or sticky %} sticky top-0 z-50{% endif %}">
    {% set current_route = app.request is defined and app.request is not null ? app.request.attributes.get('_route') : null %}
    <div class="container mx-auto px-4 py-4">
        <div class="flex items-center justify-between">
            <a href="{{ path('app_home') }}" class="text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600">
                GearForge
            </a>
            <nav class="hidden md:flex items-center space-x-6">
                <a
                    href="{{ path('app_catalogue') }}"
                    class="transition {% if current_route == 'app_catalogue' %}text-white font-semibold{% else %}text-gray-300 hover:text-white{% endif %}"
                >
                    Catalogue
                </a>
                {% if app.user %}
                    <a
                        href="{{ path('app_cart') }}"
                        class="relative inline-flex items-center transition {% if current_route == 'app_cart' %}text-white font-semibold{% else %}text-gray-300 hover:text-white{% endif %}"
                    >
                        <span>Panier</span>
                        {% if cart is defined and cart.totalItems is defined and cart.totalItems > 0 %}
                            <span class="ml-2 inline-flex items-center justify-center px-2 py-0.5 text-xs font-semibold leading-none text-white bg-pink-600 rounded-full">
                                {{ cart.totalItems }}
                            </span>
                        {% endif %}
                    </a>
                    <span class="text-gray-400">{{ app.user.email }}</span>
                    <a href="{{ path('app_logout') }}" class="text-gray-300 hover:text-white transition">Déconnexion</a>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a
                            href="{{ path('admin') }}"
                            class="transition {% if current_route == 'admin' %}text-white font-semibold{% else %}text-gray-300 hover:text-white{% endif %}"
                        >
                            Admin
                        </a>
                    {% endif %}
                {% else %}
                    <a
                        href="{{ path('app_login') }}"
                        class="transition {% if current_route == 'app_login' %}text-white font-semibold{% else %}text-gray-300 hover:text-white{% endif %}"
                    >
                        Connexion
                    </a>
                    <a
                        href="{{ path('app_register') }}"
                        class="px-4 py-2 bg-gradient-to-r from-purple-600 to-pink-600 text-white rounded-lg hover:opacity-90 transition {% if current_route == 'app_register' %}ring-2 ring-pink-400{% endif %}"
                    >
                        S'inscrire
                    </a>
                {% endif %}
            </nav>
        </div>
    </div>
</header>
