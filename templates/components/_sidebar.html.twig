{% set current = app.request.attributes.get('_route') %}

{% set items = [
  { key: 'catalogue', label: 'Catalogue', icon: '🛒', href: path('app_catalogue'), activeOn: ['app_catalogue'], hover: 'blue' },
  { key: 'profils', label: 'Profils joueurs', icon: '👤', href: '/profiles', activeOn: [], hover: 'green' },
  { key: 'panier', label: 'Panier', icon: '🛍️', href: path('app_cart'), activeOn: ['app_cart'], hover: 'red' },
  { key: 'compte', label: 'Compte', icon: '⚙️', href: '/profile', activeOn: [], hover: 'yellow' },
] %}

<aside
  data-sidebar-target="sidebar"
  class="
    shrink-0 overflow-hidden
    fixed inset-y-0 left-0 z-50
    w-0 -translate-x-full
    transform transition-[transform,width] duration-300 ease-in-out
    lg:static lg:translate-x-0
    lg:w-0 lg:transition-[width] lg:duration-300 lg:ease-in-out
    pixel-sidebar
  "
>
  <div class="h-full overflow-y-auto p-6 pixel-ui">

    <div class="flex items-start justify-between gap-3">
      <div>
        <div class="pixel-title">GEARFORGE</div>
        <span class="pixel-brand__sub">Gaming gear &amp; More</span>
      </div>

      <button type="button"
              data-action="click->sidebar#close"
              class="lg:hidden pixel-icon-btn"
              aria-label="Fermer">
        <span class="css-close" aria-hidden="true"></span>
      </button>
    </div>

    <div class="pixel-rule my-6"></div>

    <div class="pixel-label">NAVIGATION</div>

    <nav class="mt-5 space-y-4" style="font-family: 'Press Start 2P', sans-serif;"
      data-controller="nav-game"
      data-nav-game-claim-url-value="{{ app.user ? path('app_game_navbar_claim') : '' }}"
      data-nav-game-is-auth-value="{{ app.user ? '1' : '0' }}"
    >
      {% for it in items %}
        {% set isActive = it.activeOn is defined and current in it.activeOn %}
        <a href="{{ it.href }}" draggable="false" data-key="{{ it.key }}"
          data-nav-game-target="item" data-action="click->nav-game#preventClick"
          class="pixel-btn pixel-btn--maurice pixel-btn--{{ it.hover }} {{ isActive ? 'is-active' : '' }}">
          <span class="pixel-btn__ico">{{ it.icon }}</span>
          <span class="pixel-btn__text">{{ it.label }}
            {% if it.key == 'panier' and cart is defined and cart.totalItems is defined and cart.totalItems > 0 %}
              <span class="ml-2 inline-flex items-center justify-center px-2 py-0.5 text-xs font-semibold leading-none text-white bg-pink-600 rounded-full">
                {{ cart.totalItems }}
              </span>
            {% endif %}
          </span>
          <span class="pixel-btn__arrow"><span class="css-triangle-right" aria-hidden="true"></span></span>
        </a>
      {% endfor %}
    </nav>

    <div class="pixel-rule mt-25 my-6"></div>

    <div
      data-nav-game-target="status"
      class="text-[10px] leading-5 tracking-widest text-white/70"
      style="font-family: 'Press Start 2P', sans-serif;"
    >
      {% if app.user %}
        trouvez la bonne combinaison
      {% else %}
        Connectez - vous pour accéder à nos différents mini-jeux !!!
      {% endif %}
    </div>

  </div>
</aside>
