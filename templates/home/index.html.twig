{% extends 'base.html.twig' %}

{% block title %}GearForge - Gaming Equipment{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-b from-gray-900 to-gray-800">

    <section class="container mx-auto px-4 py-20">
        <div class="text-center">
            <h1 class="text-6xl md:text-7xl font-bold text-white mb-6">
                Votre équipement
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600">
                    Gaming
                </span>
                <br>de haute performance
            </h1>
            <p class="text-xl text-gray-400 mb-12 max-w-3xl mx-auto">
                Découvrez notre sélection premium de souris, claviers et casques gaming pour dominer vos parties
            </p>
            <div class="flex justify-center gap-4">
                <a href="{{ path('app_catalogue') }}" class="px-8 py-4 bg-gradient-to-r from-purple-600 to-pink-600 text-white text-lg font-bold rounded-xl hover:opacity-90 transition transform hover:scale-105">
                    🎮 Voir le catalogue
                </a>
                {% if not app.user %}
                    <a href="{{ path('app_register') }}" class="px-8 py-4 bg-gray-800 text-white text-lg font-bold rounded-xl hover:bg-gray-700 transition border border-gray-700">
                        Créer un compte
                    </a>
                {% endif %}
            </div>
        </div>
    </section>

    <section class="container mx-auto px-4 py-20">
        <div class="grid md:grid-cols-3 gap-8">
            <div class="bg-gray-800 rounded-xl p-8 border border-gray-700 hover:border-purple-500 transition">
                <div class="text-4xl mb-4">🖱️</div>
                <h3 class="text-2xl font-bold text-white mb-3">Souris Gaming</h3>
                <p class="text-gray-400">Des souris ultra-précises avec capteurs haute performance pour une réactivité maximale</p>
            </div>
            <div class="bg-gray-800 rounded-xl p-8 border border-gray-700 hover:border-purple-500 transition">
                <div class="text-4xl mb-4">⌨️</div>
                <h3 class="text-2xl font-bold text-white mb-3">Claviers Mécaniques</h3>
                <p class="text-gray-400">Switches premium et rétroéclairage RGB pour une expérience de frappe incomparable</p>
            </div>
            <div class="bg-gray-800 rounded-xl p-8 border border-gray-700 hover:border-purple-500 transition">
                <div class="text-4xl mb-4">🎧</div>
                <h3 class="text-2xl font-bold text-white mb-3">Casques Audio</h3>
                <p class="text-gray-400">Son immersif et microphones professionnels pour une communication claire</p>
            </div>
        </div>
    </section>

    <section class="container mx-auto px-4 py-20">
        <div class="bg-gradient-to-r from-purple-600/20 to-pink-600/20 rounded-2xl p-12 border border-purple-500/30">
            <div class="grid md:grid-cols-4 gap-8 text-center">
                <div>
                    <div class="text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600 mb-2">500+</div>
                    <div class="text-gray-400">Produits disponibles</div>
                </div>
                <div>
                    <div class="text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600 mb-2">10K+</div>
                    <div class="text-gray-400">Gamers satisfaits</div>
                </div>
                <div>
                    <div class="text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600 mb-2">24/7</div>
                    <div class="text-gray-400">Support client</div>
                </div>
                <div>
                    <div class="text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600 mb-2">⚡</div>
                    <div class="text-gray-400">Livraison rapide</div>
                </div>
            </div>
        </div>
    </section>

    <section class="container mx-auto px-4 py-20 text-center">
        <h2 class="text-4xl font-bold text-white mb-6">Prêt à améliorer votre setup ?</h2>
        <p class="text-xl text-gray-400 mb-8">Rejoignez des milliers de gamers qui nous font confiance</p>
        <a href="{{ path('app_catalogue') }}" class="inline-block px-12 py-5 bg-gradient-to-r from-purple-600 to-pink-600 text-white text-xl font-bold rounded-xl hover:opacity-90 transition transform hover:scale-105">
            Explorer le catalogue
        </a>
    </section>
    {{ include('components/_banner.html.twig') }}
    {{ include('components/_footer.html.twig') }}
</div>
{% endblock %}

