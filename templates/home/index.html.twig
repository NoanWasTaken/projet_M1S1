{% extends 'base.html.twig' %}

{% block title %}GearForge - Gaming Equipment{% endblock %}

{% block body %}

<div class="relative isolate overflow-x-hidden" style="font-family:'Press Start 2P', sans-serif;">

  <div class="pointer-events-none fixed inset-0 -z-10"
       style="
         background:
           linear-gradient(180deg, rgba(18,10,46,0.97), rgba(11,7,32,1)),
           linear-gradient(90deg, rgba(233,221,255,0.07) 1px, transparent 1px),
           linear-gradient(0deg,  rgba(233,221,255,0.07) 1px, transparent 1px),
           repeating-linear-gradient(45deg, rgba(233,221,255,0.05) 0 2px, rgba(0,0,0,0) 2px 5px);
         background-size: auto, 5px 5px, 5px 5px, auto;
       ">
  </div>


  <section class="container mx-auto px-6 pt-20 pb-16">
    <div class="flex flex-col items-center text-center gap-8">

      

      <div>
        <h1 class="text-2xl md:text-4xl leading-snug tracking-widest" style="color:var(--pixel-head); text-shadow:3px 3px 0 #000;">
          LEVEL UP
        </h1>
        <h1 class="mt-2 text-2xl md:text-4xl leading-snug tracking-widest" style="color:var(--color-mauve-500); text-shadow:3px 3px 0 #000;">
          YOUR SETUP
        </h1>
      </div>

      <p class="max-w-xl text-[9px] leading-loose tracking-wider" style="color:var(--secondary);">
        Souris, claviers, casques et périphériques gaming haut de gamme.<br>
        Choisissez votre arme. Dominez la partie.
      </p>

      {# CTA #}
      <div class="flex flex-wrap justify-center gap-4 mt-2">
        <a href="{{ path('app_catalogue') }}" class="pixel-btn is-cta" style="width:auto; min-width:180px;">
          <span class="pixel-btn__ico"><span class="css-triangle-right" aria-hidden="true"></span></span>
          <span class="pixel-btn__text">VOIR LE CATALOGUE</span>
          <span class="pixel-btn__arrow"><span>></span></span>
        </a>
        {% if not app.user %}
          <a href="{{ path('app_register') }}" class="pixel-btn" style="width:auto; min-width:180px;">
            <span class="pixel-btn__ico">+</span>
            <span class="pixel-btn__text">CRÉER UN COMPTE</span>
            <span class="pixel-btn__arrow"><span>></span></span>
          </a>
        {% else %}
          <a href="{{ path('app_client_profile') }}" class="pixel-btn" style="width:auto; min-width:180px;">
            <span class="pixel-btn__ico"><span class="css-circle-dot" aria-hidden="true"></span></span>
            <span class="pixel-btn__text">MON PROFIL</span>
            <span class="pixel-btn__arrow"><span>></span></span>
          </a>
        {% endif %}
      </div>

    </div>
  </section>

  <div class="mx-6 mb-20" style="height:2px; background:linear-gradient(90deg, transparent, var(--color-mauve-500), var(--tertiary), transparent);"></div>

  <section class="container mx-auto px-6 pb-20">
    <div class="mb-10 text-center">
      <p class="text-[8px] tracking-[0.4em] mb-3" style="color:var(--secondary);">CATALOGUE</p>
      <h2 class="text-base tracking-widest" style="color:var(--pixel-head); text-shadow:2px 2px 0 #000;">NOS CATÉGORIES</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

      <a href="{{ path('app_catalogue') }}?category=souris" class="home-card group block">
        <div class="home-card__icon" style="color:var(--color-mauve-400);">🖱️</div>
        <div class="home-card__title">SOURIS GAMING</div>
        <div class="home-card__desc">Capteurs high-end, switches omron, ergonomie compétitive.</div>
        <div class="home-card__cta">EXPLORER <span>></span></div>
      </a>

      <a href="{{ path('app_catalogue') }}?category=clavier" class="home-card group block">
        <div class="home-card__icon" style="color:var(--tertiary);">⌨️</div>
        <div class="home-card__title">CLAVIERS MÉCA</div>
        <div class="home-card__desc">Switches premium, rétroéclairage RGB, boîtier aluminium.</div>
        <div class="home-card__cta">EXPLORER <span>></span></div>
      </a>

      <a href="{{ path('app_catalogue') }}?category=casque" class="home-card group block">
        <div class="home-card__icon" style="color:var(--secondary);">🎧</div>
        <div class="home-card__title">CASQUES AUDIO</div>
        <div class="home-card__desc">Surround 7.1, micro détachable, confort longue durée.</div>
        <div class="home-card__cta">EXPLORER <span>></span></div>
      </a>

    </div>
  </section>


  <section class="container mx-auto px-6 pb-20">
    <div class="rounded-2xl border border-white/10 overflow-hidden"
         style="background:rgba(18,10,46,0.80);">

      <div class="ds-panel__top">
        <div class="ds-label">GEARFORGE EN CHIFFRES</div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 divide-x divide-y divide-white/10">

        <div class="flex flex-col items-center justify-center gap-3 p-8">
          <span class="text-2xl md:text-3xl tracking-tight" style="color:var(--color-mauve-400); text-shadow:2px 2px 0 #000;">500+</span>
          <span class="text-[8px] tracking-widest text-center" style="color:rgba(233,221,255,0.55);">PRODUITS</span>
        </div>

        <div class="flex flex-col items-center justify-center gap-3 p-8">
          <span class="text-2xl md:text-3xl tracking-tight" style="color:var(--tertiary); text-shadow:2px 2px 0 #000;">10K+</span>
          <span class="text-[8px] tracking-widest text-center" style="color:rgba(233,221,255,0.55);">GAMERS</span>
        </div>

        <div class="flex flex-col items-center justify-center gap-3 p-8">
          <span class="text-2xl md:text-3xl tracking-tight" style="color:var(--secondary); text-shadow:2px 2px 0 #000;">24/7</span>
          <span class="text-[8px] tracking-widest text-center" style="color:rgba(233,221,255,0.55);">SUPPORT</span>
        </div>

        <div class="flex flex-col items-center justify-center gap-3 p-8">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="var(--color-mauve-500)" style="filter:drop-shadow(2px 2px 0 #000);"><path d="M13 2L4.09 12.97 11 12l-2 10 8.91-10.97L11 12l2-10z"/></svg>
          <span class="text-[8px] tracking-widest text-center" style="color:rgba(233,221,255,0.55);">LIVRAISON RAPIDE</span>
        </div>

      </div>
    </div>
  </section>


  <section class="container mx-auto px-6 pb-20">
    <div class="rounded-2xl border border-white/10 p-8 flex flex-col md:flex-row items-center gap-8"
         style="background:rgba(44,7,53,0.70);">

      <div class="flex-1 flex flex-col gap-4">
        <p class="text-[8px] tracking-[0.3em] flex items-center gap-2" style="color:var(--color-mauve-400);"><span class="css-bullet" aria-hidden="true"></span>SYSTÈME DE PROGRESSION</p>
        <h2 class="text-sm leading-snug tracking-widest" style="color:var(--pixel-head); text-shadow:2px 2px 0 #000;">
          ACHÈTE. GAGNE DE L'XP.<br>MONTE EN NIVEAU.
        </h2>
        <p class="text-[9px] leading-loose tracking-wide" style="color:rgba(233,221,255,0.65);">
          Chaque commande te rapporte de l'expérience. Personnalise ton avatar, 
          débloque des récompenses et défie d'autres gamers.
        </p>
        <div class="mt-2">
          {% if app.user %}
            <a href="{{ path('app_client_profile') }}" class="pixel-btn is-cta" style="width:auto; display:inline-flex; min-width:160px;">
              <span class="pixel-btn__ico"><span class="css-circle-dot" aria-hidden="true"></span></span>
              <span class="pixel-btn__text">MON PROFIL</span>
              <span class="pixel-btn__arrow"><span>></span></span>
            </a>
          {% else %}
            <a href="{{ path('app_register') }}" class="pixel-btn is-cta" style="width:auto; display:inline-flex; min-width:160px;">
              <span class="pixel-btn__ico">+</span>
              <span class="pixel-btn__text">S'INSCRIRE</span>
              <span class="pixel-btn__arrow"><span>></span></span>
            </a>
          {% endif %}
        </div>
      </div>

      <div class="shrink-0 rounded-xl border border-white/10 bg-black/35 p-5 w-full md:w-56">
        <div class="text-[8px] tracking-widest mb-3" style="color:rgba(233,221,255,0.55);">PLAYER STATS</div>
        <div class="flex items-center justify-between text-[9px] mb-1" style="color:rgba(233,221,255,0.70);">
          <span>LVL 12</span><span>XP 840/1000</span>
        </div>
        <div class="h-3 rounded border border-white/15 bg-black/50 overflow-hidden mb-4">
          <div class="h-full" style="width:84%; background:var(--color-mauve-500);"></div>
        </div>
        <div class="space-y-2 text-[8px]">
          <div class="flex justify-between border-b border-white/10 pb-1" style="color:rgba(233,221,255,0.60);">
            <span>Commandes</span><span style="color:var(--secondary);">23</span>
          </div>
          <div class="flex justify-between border-b border-white/10 pb-1" style="color:rgba(233,221,255,0.60);">
            <span>Récompenses</span><span style="color:var(--color-mauve-400);">4</span>
          </div>
          <div class="flex justify-between" style="color:rgba(233,221,255,0.60);">
            <span>Rang</span><span style="color:var(--pixel-head);">PRO</span>
          </div>
        </div>
      </div>

    </div>
  </section>


  <section class="container mx-auto px-6 pb-20 text-center flex flex-col items-center gap-6">

    <div class="h-0.5 w-24 rounded-full mb-2" style="background:linear-gradient(90deg, var(--color-mauve-500), var(--tertiary));"></div>

    <h2 class="text-base tracking-widest leading-snug" style="color:var(--pixel-head); text-shadow:2px 2px 0 #000;">
      PRÊT À DOMINER ?
    </h2>
    <p class="text-[9px] leading-loose tracking-wider" style="color:var(--secondary);">
      Rejoins des milliers de gamers qui nous font confiance.
    </p>

    <a href="{{ path('app_catalogue') }}" class="pixel-btn is-cta" style="width:auto; min-width:200px;">
      <span class="pixel-btn__ico"><span class="css-triangle-right" aria-hidden="true"></span></span>
      <span class="pixel-btn__text">EXPLORER LE CATALOGUE</span>
      <span class="pixel-btn__arrow"><span>></span></span>
    </a>

  </section>

  {{ include('components/_banner.html.twig') }}
  {{ include('components/_footer.html.twig') }}

</div>
{% endblock %}

