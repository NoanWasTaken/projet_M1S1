{% extends 'base.html.twig' %}

{% block title %}Mes commandes – GearForge{% endblock %}

{% block body %}
<div class="m-5 mt-7 mb-7 p-5 rounded-2xl border border-white/10 shadow-2xl" style="background:#2C0735; font-family:'Press Start 2P', sans-serif;">

    <h1 class="text-white text-sm tracking-widest mb-6">MES COMMANDES</h1>

    {% for message in app.flashes('success') %}
        <div class="mb-4 p-3 rounded-lg bg-green-600/30 border border-green-400/40 text-green-300 text-[10px] tracking-wide">
            {{ message }}
        </div>
    {% endfor %}

    {% if orders is empty %}
        <div class="text-white/50 text-[10px] tracking-wide text-center py-12">
            Aucune commande pour l'instant.
        </div>
    {% else %}
        <div class="flex flex-col gap-3">
            {% for order in orders %}
                {% set statusColor = 'text-white/60' %}
                {% if order.status.value == 'validated' %}{% set statusColor = 'text-green-400' %}{% endif %}
                {% if order.status.value == 'pending' %}{% set statusColor = 'text-yellow-400' %}{% endif %}
                {% if order.status.value == 'cancelled' %}{% set statusColor = 'text-red-400' %}{% endif %}

                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-4 rounded-xl border border-white/10 bg-black/30 hover:bg-black/40 transition-colors">
                    <div class="flex flex-col gap-1">
                        <span class="text-white text-[10px] tracking-widest">COMMANDE #{{ order.id }}</span>
                        <span class="text-white/50 text-[9px]">{{ order.createdAt|date('d/m/Y à H:i') }}</span>
                    </div>

                    <div class="flex items-center gap-2">
                        <span class="text-[9px] uppercase tracking-widest {{ statusColor }}">
                            {{ order.status.label() }}
                        </span>
                    </div>

                    <div class="text-white text-[10px] tracking-wider">
                        {{ order.total|number_format(2, ',', ' ') }} €
                    </div>

                    <div class="flex gap-2">
                        <a href="{{ path('app_order_show', {id: order.id}) }}"
                           class="px-3 py-1 rounded-lg border border-purple-400/40 text-purple-300 text-[9px] tracking-wide hover:bg-purple-500/20 transition-colors">
                            DÉTAIL
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

</div>
{% endblock %}
