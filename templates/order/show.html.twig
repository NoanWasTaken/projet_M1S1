{% extends 'base.html.twig' %}

{% block title %}Commande #{{ order.id }} – GearForge{% endblock %}

{% block body %}
<div class="m-5 mt-7 mb-7 p-5 rounded-2xl border border-white/10 shadow-2xl" style="background:#2C0735; font-family:'Press Start 2P', sans-serif;">

    <div class="flex items-center justify-between mb-6">
        <h1 class="text-white text-sm tracking-widest">COMMANDE #{{ order.id }}</h1>
        <a href="{{ path('app_order_index') }}" class="text-white/40 text-[9px] tracking-wide hover:text-white/70 transition-colors">
            ← RETOUR
        </a>
    </div>

    {# Statut #}
    {% set statusColor = 'text-white/60 border-white/20' %}
    {% if order.status.value == 'validated' %}{% set statusColor = 'text-green-400 border-green-400/40' %}{% endif %}
    {% if order.status.value == 'pending' %}{% set statusColor = 'text-yellow-400 border-yellow-400/40' %}{% endif %}
    {% if order.status.value == 'cancelled' %}{% set statusColor = 'text-red-400 border-red-400/40' %}{% endif %}

    <div class="flex flex-wrap gap-4 mb-6 text-[9px] tracking-widest">
        <span class="px-3 py-1 rounded-full border {{ statusColor }} uppercase">
            {{ order.status.label() }}
        </span>
        <span class="text-white/40">{{ order.createdAt|date('d/m/Y à H:i') }}</span>
    </div>

    {# Articles #}
    <div class="rounded-xl border border-white/10 bg-black/30 overflow-hidden mb-5">
        <table class="w-full text-[9px] tracking-wide">
            <thead>
                <tr class="border-b border-white/10 text-white/50">
                    <th class="text-left p-3">PRODUIT</th>
                    <th class="text-center p-3">QTÉ</th>
                    <th class="text-right p-3">PRIX U.</th>
                    <th class="text-right p-3">TOTAL</th>
                </tr>
            </thead>
            <tbody>
                {% for item in order.items %}
                <tr class="border-b border-white/5 text-white">
                    <td class="p-3">{{ item.product.name }}</td>
                    <td class="p-3 text-center text-white/70">× {{ item.quantity }}</td>
                    <td class="p-3 text-right text-white/70">{{ item.unitPrice|number_format(2, ',', ' ') }} €</td>
                    <td class="p-3 text-right">{{ (item.unitPrice * item.quantity)|number_format(2, ',', ' ') }} €</td>
                </tr>
                {% endfor %}
            </tbody>
            <tfoot>
                <tr class="text-white">
                    <td colspan="3" class="p-3 text-right text-white/50 tracking-widest">TOTAL</td>
                    <td class="p-3 text-right font-bold">{{ order.total|number_format(2, ',', ' ') }} €</td>
                </tr>
            </tfoot>
        </table>
    </div>

    {# Bouton annulation #}
    {% if order.status.value in ['pending', 'validated'] %}
        {% if is_granted('ORDER_CANCEL', order) %}
            <form method="POST" action="{{ path('app_order_cancel', {id: order.id}) }}"
                  onsubmit="return confirm('Confirmer l\'annulation de cette commande ?')">
                <input type="hidden" name="_token" value="{{ csrf_token('cancel_order_' ~ order.id) }}">
                <button type="submit"
                        class="px-4 py-2 rounded-lg border border-red-400/40 text-red-400 text-[9px] tracking-widest hover:bg-red-500/20 transition-colors">
                    ANNULER LA COMMANDE
                </button>
            </form>
        {% endif %}
    {% endif %}

</div>
{% endblock %}
