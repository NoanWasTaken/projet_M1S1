{% extends 'base.html.twig' %}

{% block title %}{{ player.name }} - Pro Player - GearForge{% endblock %}

{% block body %}
<div class="relative isolate overflow-x-hidden" style="font-family:var(--font-pixel), sans-serif;">

  <div class="pointer-events-none fixed inset-0 -z-10"
       style="background:
         linear-gradient(180deg, rgba(18,10,46,0.97), rgba(11,7,32,1)),
         linear-gradient(90deg, rgba(233,221,255,0.07) 1px, transparent 1px),
         linear-gradient(0deg,  rgba(233,221,255,0.07) 1px, transparent 1px),
         repeating-linear-gradient(45deg, rgba(233,221,255,0.05) 0 2px, rgba(0,0,0,0) 2px 5px);
         background-size: auto, 5px 5px, 5px 5px, auto;">
  </div>

  <div class="container mx-auto px-6 pt-10 pb-24">

    <a href="{{ path('app_profiles_index') }}" class="detail-breadcrumb-link inline-flex items-center gap-2 mb-8">
      <span class="css-arrow-left" aria-hidden="true"></span> PRO PLAYERS
    </a>

    <div class="max-w-2xl mx-auto flex flex-col gap-6">

      <div class="detail-panel detail-panel--flush">
        <div class="flex flex-col sm:flex-row items-center gap-6 p-6">
          {% if player.photo %}
            <img src="{{ player.photo }}" alt="{{ player.name }}" class="pro-player__avatar" />
          {% else %}
            <div class="pro-player__avatar pro-player__avatar--placeholder"></div>
          {% endif %}
          <div class="text-center sm:text-left flex flex-col gap-2">
            <p class="text-[8px] tracking-[0.4em]" style="color:var(--secondary);">{{ player.game|upper }}</p>
            <h1 class="text-xl md:text-2xl tracking-widest" style="color:var(--pixel-head); text-shadow:3px 3px 0 var(--pixel-shadow);">{{ player.name }}</h1>
            <div class="flex flex-wrap gap-2 mt-1 justify-center sm:justify-start">
              <span class="detail-badge detail-badge--cat">{{ player.role }}</span>
              <span class="detail-badge">{{ player.team }}</span>
              <span class="detail-badge">{{ player.country }}</span>
            </div>
          </div>
        </div>
      </div>

      {% if player.description %}
      <div class="detail-panel detail-panel--flush">
        <div class="ds-panel__top">
          <span class="ds-label">DESCRIPTION</span>
        </div>
        <div class="p-5">
          <p style="font-family:var(--font-ui),sans-serif; font-size:13px; line-height:1.8; color:rgba(233,221,255,0.65);">{{ player.description }}</p>
        </div>
      </div>
      {% endif %}

      <div class="detail-panel detail-panel--flush">
        <div class="ds-panel__top">
          <span class="ds-label">CONFIGURATION DU JOUEUR</span>
        </div>
        <div class="p-5 flex flex-col gap-0">

          <div class="player-gear__row">
            <div class="player-gear__info">
              <p class="player-gear__label">SOURIS</p>
              <p class="player-gear__product">{{ player.mouse }}</p>
            </div>
            <form method="post" action="{{ path('player_add_product', {id: player.id, type: 'mouse'}) }}">
              <button type="submit" class="pixel-btn is-cta" style="padding:0.5rem 0.9rem;">
                <span class="pixel-btn__text">AJOUTER AU PANIER</span>
              </button>
            </form>
          </div>

          <div class="player-gear__row">
            <div class="player-gear__info">
              <p class="player-gear__label">CLAVIER</p>
              <p class="player-gear__product">{{ player.keyboard }}</p>
            </div>
            <form method="post" action="{{ path('player_add_product', {id: player.id, type: 'keyboard'}) }}">
              <button type="submit" class="pixel-btn is-cta" style="padding:0.5rem 0.9rem;">
                <span class="pixel-btn__text">AJOUTER AU PANIER</span>
              </button>
            </form>
          </div>

          <div class="player-gear__row" style="border-bottom:none;">
            <div class="player-gear__info">
              <p class="player-gear__label">CASQUE</p>
              <p class="player-gear__product">{{ player.headset }}</p>
            </div>
            <form method="post" action="{{ path('player_add_product', {id: player.id, type: 'headset'}) }}">
              <button type="submit" class="pixel-btn is-cta" style="padding:0.5rem 0.9rem;">
                <span class="pixel-btn__text">AJOUTER AU PANIER</span>
              </button>
            </form>
          </div>

        </div>
        <div class="p-5 pt-0">
          <form method="post" action="{{ path('player_add_config', {id: player.id}) }}" style="display:flex; justify-content:center;">
            <button type="submit" class="pixel-btn is-cta" style="width:100%; justify-content:center; text-align:center;">
              <span class="pixel-btn__text" style="text-align:center;">AJOUTER TOUTE LA CONFIG AU PANIER</span>
            </button>
          </form>
        </div>
      </div>

    </div>
  </div>

  {{ include('components/_footer.html.twig') }}
</div>
{% endblock %}
