{% extends 'base.html.twig' %}

{% block title %}Profil joueur{% endblock %}

{% block body %}


<div class="min-h-screen flex flex-col bg-gradient-to-br from-gray-900 via-gray-800 to-purple-900">
    <div class="flex-grow flex flex-col items-center justify-center py-10">
        <div class="max-w-2xl w-full bg-gray-900 rounded-2xl shadow-2xl p-8 flex flex-col items-center">
            <h1 class="text-4xl font-bold text-pink-500 mb-4">{{ player.name }}</h1>
            <img src="{{ player.photo }}" alt="Photo joueur" class="w-40 h-40 rounded-full object-cover border-4 border-pink-400 mb-6 shadow-lg" />
            <div class="text-lg text-gray-300 mb-2">
                <span class="font-semibold text-purple-400">Rôle :</span> {{ player.role }}
                <span class="mx-2">•</span>
                <span class="font-semibold text-purple-400">Équipe :</span> {{ player.team }}
                <span class="mx-2">•</span>
                <span class="font-semibold text-purple-400">Pays :</span> {{ player.country }}
                <span class="mx-2">•</span>
                <span class="font-semibold text-purple-400">Jeu :</span> {{ player.game }}
            </div>
            <div class="w-full mt-6 mb-6 bg-gray-800 rounded-xl p-6 shadow">
                <h2 class="text-2xl font-bold text-pink-400 mb-2">Description</h2>
                <p class="text-gray-200">{{ player.description ? player.description : 'Aucune description disponible.' }}</p>
            </div>
            <div class="w-full mb-6 bg-gray-800 rounded-xl p-6 shadow">
                <h2 class="text-2xl font-bold text-purple-400 mb-2">Configuration</h2>
                <ul class="space-y-4">
                    <li class="flex items-center justify-between">
                        <span><span class="font-bold text-pink-400">Souris :</span> <span class="text-white">{{ player.mouse }}</span></span>
                        <form method="post" action="{{ path('player_add_product', {id: player.id, type: 'mouse'}) }}">
                            <button type="submit" class="px-4 py-2 bg-gradient-to-r from-purple-600 to-pink-600 text-white rounded-xl font-bold shadow hover:scale-105 transition">Ajouter au panier</button>
                        </form>
                    </li>
                    <li class="flex items-center justify-between">
                        <span><span class="font-bold text-pink-400">Clavier :</span> <span class="text-white">{{ player.keyboard }}</span></span>
                        <form method="post" action="{{ path('player_add_product', {id: player.id, type: 'keyboard'}) }}">
                            <button type="submit" class="px-4 py-2 bg-gradient-to-r from-purple-600 to-pink-600 text-white rounded-xl font-bold shadow hover:scale-105 transition">Ajouter au panier</button>
                        </form>
                    </li>
                <li class="flex items-center justify-between">
                    <span><span class="font-bold text-pink-400">Casque :</span> <span class="text-white">{{ player.headset }}</span></span>
                    <form method="post" action="{{ path('player_add_product', {id: player.id, type: 'headset'}) }}">
                        <button type="submit" class="px-4 py-2 bg-gradient-to-r from-purple-600 to-pink-600 text-white rounded-xl font-bold shadow hover:scale-105 transition">Ajouter au panier</button>
                    </form>
                </li>
            </ul>
            <form method="post" action="{{ path('player_add_config', {id: player.id}) }}" class="mt-6 flex justify-center">
                <button type="submit" class="px-6 py-3 bg-gradient-to-r from-purple-600 to-pink-600 text-white rounded-2xl font-bold text-lg shadow-lg hover:scale-105 transition">Ajouter toute la config au panier</button>
            </form>
        </div>
    </div>
</div>
<div class="w-full mt-8">
    <div class="flex gap-4 mb-4">
        <button class="px-6 py-2 rounded-t-xl bg-purple-700 text-white font-bold">Infos générales</button>
        <button class="px-6 py-2 rounded-t-xl bg-pink-700 text-white font-bold">Skins</button>
        <button class="px-6 py-2 rounded-t-xl bg-green-700 text-white font-bold">Paniers enregistrés</button>
    </div>
    <div class="bg-gray-900 rounded-b-xl p-6 shadow-xl">
        <h2 class="text-2xl font-bold text-green-400 mb-4">Mes paniers enregistrés</h2>
        {% if savedCarts is defined and savedCarts|length > 0 %}
            <ul class="space-y-4">
                {% for cart in savedCarts %}
                    <li class="flex items-center justify-between bg-gray-800 rounded-xl p-4">
                        <span class="font-bold text-green-300">{{ cart.name }}</span>
                        <form method="post" action="/cart/load/{{ cart.id }}">
                            <button type="submit" class="px-4 py-2 bg-gradient-to-r from-green-600 to-blue-600 text-white rounded-xl font-bold shadow hover:scale-105 transition">Charger</button>
                        </form>
                        <form method="post" action="/cart/delete/{{ cart.id }}" class="ml-2">
                            <button type="submit" class="px-4 py-2 bg-red-600 text-white rounded-xl font-bold shadow hover:scale-105 transition">Supprimer</button>
                        </form>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="text-gray-400">Aucun panier enregistré pour l'instant.</p>
        {% endif %}
    </div>
</div>
{{ include('components/_footer.html.twig') }}

{% endblock %}
