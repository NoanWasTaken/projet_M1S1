{% extends 'base.html.twig' %}

{% block title %}Catalogue Gaming - GearForge{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-b from-gray-900 to-gray-800">
    {{ include('components/_navbar.html.twig') }}

    <div class="container mx-auto px-4 py-8">
        <!-- Hero Section -->
        <div class="text-center mb-12">
            <h1 class="text-5xl font-bold text-white mb-4">
                Équipement <span class="text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600">Gaming</span> Premium
            </h1>
            <p class="text-xl text-gray-400">Découvrez notre sélection de matériel high-tech pour les gamers</p>
        </div>

        <!-- Search Bar -->
        <div class="max-w-2xl mx-auto mb-8">
            <form method="get" action="{{ path('app_catalogue') }}" class="relative">
                <input 
                    type="text" 
                    name="search" 
                    value="{{ searchQuery ?? '' }}"
                    placeholder="Rechercher un produit..." 
                    class="w-full px-6 py-4 bg-gray-800 text-white rounded-lg border border-gray-700 focus:border-purple-500 focus:outline-none focus:ring-2 focus:ring-purple-500"
                >
                <button type="submit" class="absolute right-3 top-1/2 -translate-y-1/2 px-6 py-2 bg-gradient-to-r from-purple-600 to-pink-600 text-white rounded-lg hover:opacity-90 transition">
                    Rechercher
                </button>
            </form>
        </div>

        <!-- Categories Filter -->
        <div class="flex flex-wrap justify-center gap-4 mb-12">
            <a href="{{ path('app_catalogue') }}" 
               class="px-6 py-3 rounded-lg transition {{ currentCategory is null ? 'bg-gradient-to-r from-purple-600 to-pink-600 text-white' : 'bg-gray-800 text-gray-300 hover:bg-gray-700' }}">
                Tous les produits
            </a>
            {% for category in categories %}
                <a href="{{ path('app_catalogue', {category: category}) }}" 
                   class="px-6 py-3 rounded-lg transition capitalize {{ currentCategory == category ? 'bg-gradient-to-r from-purple-600 to-pink-600 text-white' : 'bg-gray-800 text-gray-300 hover:bg-gray-700' }}">
                    {{ category }}
                </a>
            {% endfor %}
        </div>

        <!-- Products Grid -->
        {% if products|length > 0 %}
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
                {% for product in products %}
                    <div class="bg-gray-800 rounded-xl overflow-hidden border border-gray-700 hover:border-purple-500 transition-all duration-300 transform hover:-translate-y-2 hover:shadow-2xl hover:shadow-purple-500/20">
                        <!-- Product Image -->
                        <div class="relative h-64 bg-gray-900 overflow-hidden group">
                            {% if product.photos is not empty %}
                                <img src="{{ product.photos[0] }}" alt="{{ product.name }}" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300">
                            {% else %}
                                <div class="w-full h-full flex items-center justify-center">
                                    <svg class="w-24 h-24 text-gray-700" fill="currentColor" viewBox="0 0 20 20">
                                        <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"></path>
                                    </svg>
                                </div>
                            {% endif %}
                            
                            <!-- Badge Category -->
                            <div class="absolute top-3 left-3">
                                <span class="px-3 py-1 bg-purple-600/90 backdrop-blur-sm text-white text-xs font-semibold rounded-full capitalize">
                                    {{ product.category }}
                                </span>
                            </div>
                            
                            <!-- Stock Badge -->
                            {% if product.stock < 5 %}
                                <div class="absolute top-3 right-3">
                                    <span class="px-3 py-1 bg-red-600/90 backdrop-blur-sm text-white text-xs font-semibold rounded-full">
                                        Stock limité
                                    </span>
                                </div>
                            {% endif %}
                        </div>

                        <!-- Product Info -->
                        <div class="p-6">
                            <!-- Brand -->
                            {% if product.brand %}
                                <p class="text-purple-400 text-sm font-semibold mb-2">{{ product.brand }}</p>
                            {% endif %}

                            <!-- Product Name -->
                            <h3 class="text-xl font-bold text-white mb-2 line-clamp-2">{{ product.name }}</h3>

                            <!-- Rating -->
                            {% if product.rating %}
                                <div class="flex items-center mb-3">
                                    <div class="flex text-yellow-400">
                                        {% for i in 1..5 %}
                                            {% if i <= product.rating %}
                                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                                            {% else %}
                                                <svg class="w-4 h-4 text-gray-600" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                    <span class="ml-2 text-gray-400 text-sm">{{ product.rating }}/5</span>
                                </div>
                            {% endif %}

                            <!-- Description -->
                            <p class="text-gray-400 text-sm mb-4 line-clamp-2">{{ product.description }}</p>

                            <!-- Price & Action -->
                            <div class="flex items-center justify-between mt-4 pt-4 border-t border-gray-700">
                                <div>
                                    <span class="text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600">
                                        {{ product.price }}€
                                    </span>
                                </div>
                                <a href="{{ path('app_product_detail', {id: product.id}) }}" 
                                   class="px-6 py-3 bg-gradient-to-r from-purple-600 to-pink-600 text-white rounded-lg hover:opacity-90 transition font-semibold">
                                    Voir détails
                                </a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <!-- Empty State -->
            <div class="text-center py-20">
                <svg class="w-24 h-24 mx-auto text-gray-700 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"></path>
                </svg>
                <h3 class="text-2xl font-bold text-white mb-2">Aucun produit trouvé</h3>
                <p class="text-gray-400 mb-6">Essayez de modifier vos filtres ou votre recherche</p>
                <a href="{{ path('app_catalogue') }}" class="inline-block px-6 py-3 bg-gradient-to-r from-purple-600 to-pink-600 text-white rounded-lg hover:opacity-90 transition">
                    Voir tous les produits
                </a>
            </div>
        {% endif %}
    </div>

    {{ include('components/_footer.html.twig') }}
</div>
{% endblock %}
