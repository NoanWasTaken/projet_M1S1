{% extends 'base.html.twig' %}

{% block title %}Catalogue - GearForge{% endblock %}

{% block body %}
<div class="relative isolate overflow-x-hidden" style="font-family:'Press Start 2P', sans-serif;">

  <div class="pointer-events-none fixed inset-0 -z-10"
       style="
         background:
           linear-gradient(180deg, rgba(18,10,46,0.97), rgba(11,7,32,1)),
           linear-gradient(90deg, rgba(233,221,255,0.07) 1px, transparent 1px),
           linear-gradient(0deg,  rgba(233,221,255,0.07) 1px, transparent 1px),
           repeating-linear-gradient(45deg, rgba(233,221,255,0.05) 0 2px, rgba(0,0,0,0) 2px 5px);
         background-size: auto, 5px 5px, 5px 5px, auto;
       ">
  </div>

  <div class="container mx-auto px-6 pt-12 pb-20">

    <div class="mb-10 flex flex-col items-center gap-3 text-center">
      <p class="text-[8px] tracking-[0.4em]" style="color:var(--secondary);">CATALOGUE</p>
      <h1 class="text-xl md:text-2xl tracking-widest leading-snug" style="color:var(--pixel-head); text-shadow:3px 3px 0 #000;">
        EQUIPEMENT GAMING
      </h1>
      <div class="h-[2px] w-24 rounded-full" style="background:linear-gradient(90deg, var(--color-mauve-500), var(--tertiary));"></div>
      <p class="text-[9px] tracking-wider" style="color:rgba(233,221,255,0.55);">
        {{ products|length }} produit{{ products|length > 1 ? 's' : '' }} disponible{{ products|length > 1 ? 's' : '' }}
      </p>
    </div>

    <div class="max-w-2xl mx-auto mb-10">
      <form method="get" action="{{ path('app_catalogue') }}" class="cat-search">
        {% if currentCategory is not null %}
          <input type="hidden" name="category" value="{{ currentCategory }}">
        {% endif %}
        <input
          type="text"
          name="search"
          value="{{ searchQuery ?? '' }}"
          placeholder="Rechercher un produit..."
          class="cat-search__field"
        >
        <button type="submit"
                class="flex-shrink-0 px-5 py-3 text-[9px] tracking-widest transition-colors"
                style="background:var(--pixel-accent); color:var(--pixel-border); border-left:4px solid var(--pixel-border); font-family:var(--font-pixel),sans-serif;">
          SEARCH
        </button>
      </form>
    </div>

    <div class="flex flex-wrap justify-center gap-2 mb-12">
      <a href="{{ path('app_catalogue') }}"
         class="cat-filter {{ currentCategory is null ? 'is-active' : '' }}">
        TOUS
      </a>
      {% for category in categories %}
        <a href="{{ path('app_catalogue', {category: category}) }}"
           class="cat-filter {{ currentCategory == category ? 'is-active' : '' }}">
          {{ category|upper }}
        </a>
      {% endfor %}
    </div>


    {% if products|length > 0 %}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {% for product in products %}
          <article class="product-card">


            <div class="product-card__img-wrap">
              {% if product.photos is not empty %}
                <img src="{{ product.photos[0] }}" alt="{{ product.name }}" class="product-card__img">
              {% else %}
                <div class="product-card__img-placeholder">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color:rgba(233,221,255,0.2);">
                    <rect x="3" y="3" width="18" height="18" rx="2"/><path d="m3 9 4-4 4 4 4-4 4 4"/>
                    <circle cx="8.5" cy="13.5" r="1.5"/>
                  </svg>
                </div>
              {% endif %}

              <span class="product-card__badge">{{ product.category|upper }}</span>

              {% if product.stock is defined and product.stock < 5 %}
                <span class="product-card__badge product-card__badge--alert">STOCK LIMITE</span>
              {% endif %}
            </div>

            <div class="product-card__body">
              {% if product.brand %}
                <p class="product-card__brand">{{ product.brand|upper }}</p>
              {% endif %}

              <h3 class="product-card__name">{{ product.name }}</h3>

              {% if product.rating %}
                <div class="product-card__stars">
                  {% for i in 1..5 %}
                    <svg width="10" height="10" viewBox="0 0 20 20" fill="{{ i <= product.rating ? 'var(--color-mauve-400)' : 'rgba(233,221,255,0.15)' }}">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                  {% endfor %}
                  <span class="product-card__rating-txt">{{ product.rating }}/5</span>
                </div>
              {% endif %}

              <p class="product-card__desc">{{ product.description }}</p>

              <div class="product-card__footer">
                <span class="product-card__price">{{ product.price }}€</span>
                <a href="{{ path('app_product_detail', {id: product.id}) }}" class="product-card__cta">
                  VOIR
                </a>
              </div>
            </div>

          </article>
        {% endfor %}
      </div>

    {% else %}
      <div class="rounded-2xl border border-white/10 bg-black/30 p-16 flex flex-col items-center gap-6 text-center">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" style="color:rgba(233,221,255,0.15);">
          <path d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
        </svg>
        <div>
          <p class="text-[10px] tracking-widest mb-3" style="color:var(--pixel-head);">AUCUN RÉSULTAT</p>
          <p class="text-[9px] tracking-wide" style="color:rgba(233,221,255,0.45);">Modifiez vos filtres ou votre recherche.</p>
        </div>
        <a href="{{ path('app_catalogue') }}" class="pixel-btn is-cta" style="width:auto; min-width:160px;">
          <span class="pixel-btn__text">VOIR TOUT</span>
          <span class="pixel-btn__arrow"><span class="css-arrow-right" aria-hidden="true"></span></span>
        </a>
      </div>
    {% endif %}

  </div>
  {{ include('components/cpstest.html.twig') }}
  {{ include('components/_keyboardTest.html.twig') }}
  {{ include('components/_footer.html.twig') }}
</div>
{% endblock %}
