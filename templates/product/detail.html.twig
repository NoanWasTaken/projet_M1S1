{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} - GearForge{% endblock %}

{% block body %}
<div class="relative isolate overflow-x-hidden" style="font-family:'Press Start 2P', sans-serif;">

  <div class="pointer-events-none fixed inset-0 -z-10"
       style="
         background:
           linear-gradient(180deg, rgba(18,10,46,0.97), rgba(11,7,32,1)),
           linear-gradient(90deg, rgba(233,221,255,0.07) 1px, transparent 1px),
           linear-gradient(0deg,  rgba(233,221,255,0.07) 1px, transparent 1px),
           repeating-linear-gradient(45deg, rgba(233,221,255,0.05) 0 2px, rgba(0,0,0,0) 2px 5px);
         background-size: auto, 5px 5px, 5px 5px, auto;
       ">
  </div>

  <div class="container mx-auto px-6 pt-10 pb-20">


    <nav class="flex flex-wrap items-center gap-2 mb-10 text-[8px] tracking-wider" style="color:rgba(233,221,255,0.40);">
      <a href="{{ path('app_home') }}" class="detail-breadcrumb-link">ACCUEIL</a>
      <span style="color:rgba(233,221,255,0.20);">/</span>
      <a href="{{ path('app_catalogue') }}" class="detail-breadcrumb-link">CATALOGUE</a>
      <span style="color:rgba(233,221,255,0.20);">/</span>
      <a href="{{ path('app_catalogue', {category: product.category}) }}" class="detail-breadcrumb-link">{{ product.category|upper }}</a>
      <span style="color:rgba(233,221,255,0.20);">/</span>
      <span style="color:var(--pixel-head);">{{ product.name }}</span>
    </nav>


    <div class="grid md:grid-cols-2 gap-8 mb-12">

      <div class="detail-panel flex items-center justify-center" style="min-height:340px;">
        {% if product.photos is not empty %}
          <img src="{{ product.photos[0] }}" alt="{{ product.name }}"
               class="w-full h-auto rounded-lg object-contain" style="max-height:420px;">
        {% else %}
          <div class="flex flex-col items-center gap-4">
            <svg width="96" height="96" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"
                 style="color:rgba(233,221,255,0.15);">
              <rect x="3" y="3" width="18" height="18" rx="2"/>
              <path d="m3 9 4-4 4 4 4-4 4 4"/>
              <circle cx="8.5" cy="13.5" r="1.5"/>
            </svg>
            <p class="text-[8px] tracking-widest" style="color:rgba(233,221,255,0.20);">PAS D'IMAGE</p>
          </div>
        {% endif %}
      </div>

      <div class="flex flex-col gap-6">

        <div class="flex flex-wrap items-center gap-3">
          {% if product.brand %}
            <span class="detail-badge detail-badge--brand">{{ product.brand|upper }}</span>
          {% endif %}
          <span class="detail-badge detail-badge--cat">{{ product.category|upper }}</span>
        </div>

        <h1 class="text-xl md:text-2xl leading-snug tracking-wide" style="color:var(--pixel-head); text-shadow:3px 3px 0 #000;">
          {{ product.name }}
        </h1>

        {% if product.rating %}
          <div class="flex items-center gap-2">
            {% for i in 1..5 %}
              <svg width="14" height="14" viewBox="0 0 20 20"
                   fill="{{ i <= product.rating ? 'var(--color-mauve-400)' : 'rgba(233,221,255,0.15)' }}">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            {% endfor %}
            <span class="text-[8px] tracking-widest" style="color:rgba(233,221,255,0.45);">{{ product.rating }}/5</span>
          </div>
        {% endif %}

        <div class="py-4 border-y" style="border-color:rgba(233,221,255,0.08);">
          <span class="text-3xl md:text-4xl tracking-wider"
                style="color:var(--pixel-head); text-shadow:4px 4px 0 var(--pixel-shadow); font-family:var(--font-pixel),sans-serif;">
            {{ product.price }}€
          </span>
        </div>

        <div>
          {% if product.stock > 10 %}
            <div class="detail-stock detail-stock--ok">
              <span class="detail-stock__dot" style="background:#22c55e;"></span>
              EN STOCK ({{ product.stock }} DISPOS)
            </div>
          {% elseif product.stock > 0 %}
            <div class="detail-stock detail-stock--low">
              <span class="detail-stock__dot" style="background:#f97316;"></span>
              STOCK LIMITE ({{ product.stock }} RESTANTS)
            </div>
          {% else %}
            <div class="detail-stock detail-stock--out">
              <span class="detail-stock__dot" style="background:#ef4444;"></span>
              RUPTURE DE STOCK
            </div>
          {% endif %}
        </div>

        {% if product.description %}
          <p style="font-family:'Inter',sans-serif; font-size:13px; line-height:1.7; color:rgba(233,221,255,0.60);">
            {{ product.description }}
          </p>
        {% endif %}

        {% if product.stock > 0 %}
          {% if app.user %}
            <form method="post" action="{{ path('app_cart_add', {id: product.id}) }}">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="pixel-btn is-cta" style="width:100%; justify-content:center;">
                <span class="pixel-btn__text">AJOUTER AU PANIER</span>
                <span class="pixel-btn__arrow"><span class="css-arrow-right" aria-hidden="true"></span></span>
              </button>
            </form>
          {% else %}
            <a href="{{ path('app_login') }}" class="pixel-btn is-cta" style="width:100%; justify-content:center; text-decoration:none;">
              <span class="pixel-btn__text">CONNECTEZ-VOUS POUR COMMANDER</span>
              <span class="pixel-btn__arrow"><span class="css-arrow-right" aria-hidden="true"></span></span>
            </a>
          {% endif %}
        {% else %}
          <button class="pixel-btn" disabled style="width:100%; justify-content:center; opacity:0.40; cursor:not-allowed;">
            <span class="pixel-btn__text">PRODUIT INDISPONIBLE</span>
          </button>
        {% endif %}

      </div>
    </div>

    {% if product.specifications %}
      <div class="detail-panel detail-panel--flush mb-10">
        <div class="ds-panel__top mb-0">
          <span class="ds-label">CARACTERISTIQUES TECHNIQUES</span>
        </div>
        <div class="grid md:grid-cols-2 gap-0 divide-y divide-white/5">
          {% for key, value in product.specifications %}
            <div class="flex justify-between items-center px-5 py-3">
              <span class="text-[8px] tracking-wider" style="color:rgba(233,221,255,0.45);">
                {{ key|replace({'_': ' '})|upper }}
              </span>
              <span class="text-[9px] tracking-wide" style="color:var(--pixel-border);">{{ value }}</span>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    <section>
      <div class="flex items-center gap-4 mb-8">
        <h2 class="text-[13px] tracking-widest" style="color:var(--pixel-head);">AVIS CLIENTS</h2>
        <span class="detail-badge detail-badge--count">{{ product.reviews|length }}</span>
      </div>

      {% for message in app.flashes('success') %}
        <div class="detail-flash detail-flash--success mb-5">{{ message }}</div>
      {% endfor %}
      {% for message in app.flashes('error') %}
        <div class="detail-flash detail-flash--error mb-5">{{ message }}</div>
      {% endfor %}

      {% if app.user %}
        <div class="detail-panel detail-panel--flush mb-8">
          <div class="ds-panel__top mb-0">
            <span class="ds-label">LAISSER UN AVIS</span>
          </div>
          <div class="p-6">
            {{ form_start(reviewForm, {attr: {class: 'detail-form'}}) }}
              <div class="detail-form__row">
                {{ form_label(reviewForm.rating, null, {label_attr: {class: 'detail-form__label'}}) }}
                {{ form_widget(reviewForm.rating, {attr: {class: 'detail-form__select'}}) }}
                {{ form_errors(reviewForm.rating) }}
              </div>
              <div class="detail-form__row">
                {{ form_label(reviewForm.comment, null, {label_attr: {class: 'detail-form__label'}}) }}
                {{ form_widget(reviewForm.comment, {attr: {class: 'detail-form__textarea', rows: 4}}) }}
                {{ form_errors(reviewForm.comment) }}
              </div>
              <button type="submit" class="pixel-btn is-cta" style="width:auto; min-width:180px;">
                <span class="pixel-btn__text">PUBLIER MON AVIS</span>
                <span class="pixel-btn__arrow"><span class="css-arrow-right" aria-hidden="true"></span></span>
              </button>
            {{ form_end(reviewForm) }}
          </div>
        </div>
      {% else %}
        <div class="detail-panel mb-8 flex flex-col items-center gap-4 py-8 text-center">
          <p class="text-[9px] tracking-wider" style="color:rgba(233,221,255,0.45);">CONNECTEZ-VOUS POUR LAISSER UN AVIS</p>
          <a href="{{ path('app_login') }}" class="pixel-btn is-cta" style="width:auto; min-width:160px; text-decoration:none; justify-content:center;">
            <span class="pixel-btn__text">SE CONNECTER</span>
            <span class="pixel-btn__arrow"><span class="css-arrow-right" aria-hidden="true"></span></span>
          </a>
        </div>
      {% endif %}

      {% if product.reviews|length > 0 %}
        <div class="flex flex-col gap-4">
          {% for review in product.reviews %}
            <div class="detail-panel">
              <div class="flex items-start justify-between flex-wrap gap-4 mb-4">
                <div>
                  <p class="text-[9px] tracking-widest mb-1" style="color:var(--pixel-head);">{{ review.authorName }}</p>
                  <p class="text-[7px] tracking-wider" style="color:rgba(233,221,255,0.30); font-family:'Inter',sans-serif;">
                    {{ review.createdAt|date('d/m/Y') }}
                  </p>
                </div>
                <div class="flex items-center gap-2">
                  {% for i in 1..5 %}
                    <svg width="12" height="12" viewBox="0 0 20 20"
                         fill="{{ i <= review.rating ? 'var(--color-mauve-400)' : 'rgba(233,221,255,0.15)' }}">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                  {% endfor %}
                  <span class="text-[7px]" style="color:rgba(233,221,255,0.35);">{{ review.rating }}/5</span>
                </div>
              </div>
              {% if review.comment %}
                <p style="font-family:'Inter',sans-serif; font-size:13px; line-height:1.65; color:rgba(233,221,255,0.60);">
                  {{ review.comment }}
                </p>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% else %}
        <div class="detail-panel flex items-center justify-center py-12 text-center">
          <p class="text-[9px] tracking-widest" style="color:rgba(233,221,255,0.30);">AUCUN AVIS — SOYEZ LE PREMIER !</p>
        </div>
      {% endif %}

    </section>

    <div class="mt-14 flex justify-center">
      <a href="{{ path('app_catalogue') }}" class="pixel-btn" style="text-decoration:none;">
        <span class="pixel-btn__ico"><span class="css-arrow-left" aria-hidden="true"></span></span>
        <span class="pixel-btn__text">RETOUR AU CATALOGUE</span>
      </a>
    </div>

  </div>

  {{ include('components/_footer.html.twig') }}
</div>
{% endblock %}