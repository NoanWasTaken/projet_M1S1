{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} - GearForge{% endblock %}

{% block body %}
<div class="min-h-screen bg-gradient-to-b from-gray-900 to-gray-800">
    <!-- Header -->
    <header class="bg-gray-900/50 backdrop-blur-sm border-b border-gray-700 sticky top-0 z-50">
        <div class="container mx-auto px-4 py-4">
            <div class="flex items-center justify-between">
                <a href="{{ path('app_home') }}" class="text-2xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600">
                    GearForge
                </a>
                <nav class="hidden md:flex items-center space-x-6">
                    <a href="{{ path('app_catalogue') }}" class="text-gray-300 hover:text-white transition">Catalogue</a>
                    {% if app.user %}
                        <a href="{{ path('app_cart') }}" class="relative text-gray-300 hover:text-white transition">
                            Panier
                        </a>
                        <span class="text-gray-400">{{ app.user.email }}</span>
                        <a href="{{ path('app_logout') }}" class="text-gray-300 hover:text-white transition">Déconnexion</a>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="text-gray-300 hover:text-white transition">Connexion</a>
                        <a href="{{ path('app_register') }}" class="px-4 py-2 bg-gradient-to-r from-purple-600 to-pink-600 text-white rounded-lg hover:opacity-90 transition">S'inscrire</a>
                    {% endif %}
                </nav>
            </div>
        </div>
    </header>

    <div class="container mx-auto px-4 py-8">
        <!-- Breadcrumb -->
        <div class="mb-8">
            <nav class="flex text-gray-400 text-sm">
                <a href="{{ path('app_home') }}" class="hover:text-white">Accueil</a>
                <span class="mx-2">/</span>
                <a href="{{ path('app_catalogue') }}" class="hover:text-white">Catalogue</a>
                <span class="mx-2">/</span>
                <span class="text-white capitalize">{{ product.category }}</span>
                <span class="mx-2">/</span>
                <span class="text-white">{{ product.name }}</span>
            </nav>
        </div>

        <!-- Product Detail -->
        <div class="grid md:grid-cols-2 gap-12 mb-12">
            <!-- Product Image -->
            <div class="bg-gray-800 rounded-2xl p-8 border border-gray-700">
                {% if product.image %}
                    <img src="{{ product.image }}" alt="{{ product.name }}" class="w-full h-auto rounded-lg">
                {% else %}
                    <div class="w-full aspect-square bg-gray-900 rounded-lg flex items-center justify-center">
                        <svg class="w-48 h-48 text-gray-700" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"></path>
                        </svg>
                    </div>
                {% endif %}
            </div>

            <!-- Product Info -->
            <div>
                <!-- Brand & Category -->
                <div class="flex items-center gap-4 mb-4">
                    {% if product.brand %}
                        <span class="px-4 py-2 bg-purple-600/20 text-purple-400 rounded-full text-sm font-semibold">
                            {{ product.brand }}
                        </span>
                    {% endif %}
                    <span class="px-4 py-2 bg-gray-700 text-gray-300 rounded-full text-sm font-semibold capitalize">
                        {{ product.category }}
                    </span>
                </div>

                <!-- Product Name -->
                <h1 class="text-4xl font-bold text-white mb-4">{{ product.name }}</h1>

                <!-- Rating -->
                {% if product.rating %}
                    <div class="flex items-center mb-6">
                        <div class="flex text-yellow-400">
                            {% for i in 1..5 %}
                                {% if i <= product.rating %}
                                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                                {% else %}
                                    <svg class="w-6 h-6 text-gray-600" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
                                {% endif %}
                            {% endfor %}
                        </div>
                        <span class="ml-3 text-gray-300 text-lg">{{ product.rating }}/5</span>
                    </div>
                {% endif %}

                <!-- Price -->
                <div class="mb-8">
                    <span class="text-5xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-pink-600">
                        {{ product.price }}€
                    </span>
                </div>

                <!-- Stock Status -->
                <div class="mb-8">
                    {% if product.stock > 10 %}
                        <div class="flex items-center text-green-400">
                            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                            </svg>
                            <span class="font-semibold">En stock ({{ product.stock }} disponibles)</span>
                        </div>
                    {% elseif product.stock > 0 %}
                        <div class="flex items-center text-orange-400">
                            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd"></path>
                            </svg>
                            <span class="font-semibold">Stock limité ({{ product.stock }} restants)</span>
                        </div>
                    {% else %}
                        <div class="flex items-center text-red-400">
                            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                            </svg>
                            <span class="font-semibold">Rupture de stock</span>
                        </div>
                    {% endif %}
                </div>

                <!-- Description -->
                <div class="mb-8">
                    <h2 class="text-2xl font-bold text-white mb-4">Description</h2>
                    <p class="text-gray-300 leading-relaxed">{{ product.description }}</p>
                </div>

                <!-- Add to Cart Button -->
                {% if product.stock > 0 %}
                    {% if app.user %}
                        <form method="post" action="{{ path('app_cart_add', {id: product.id}) }}">
                            <input type="hidden" name="quantity" value="1">
                            <button type="submit" class="w-full py-4 bg-gradient-to-r from-purple-600 to-pink-600 text-white text-lg font-bold rounded-xl hover:opacity-90 transition transform hover:scale-105">
                                🛒 Ajouter au panier
                            </button>
                        </form>
                    {% else %}
                        <a href="{{ path('app_login') }}" class="block w-full py-4 bg-gradient-to-r from-purple-600 to-pink-600 text-white text-lg font-bold rounded-xl hover:opacity-90 transition transform hover:scale-105 text-center">
                            🔒 Connectez-vous pour commander
                        </a>
                    {% endif %}
                {% else %}
                    <button class="w-full py-4 bg-gray-700 text-gray-400 text-lg font-bold rounded-xl cursor-not-allowed" disabled>
                        Produit indisponible
                    </button>
                {% endif %}
            </div>
        </div>

        <!-- Specifications -->
        {% if product.specifications %}
            <div class="bg-gray-800 rounded-2xl p-8 border border-gray-700 mb-12">
                <h2 class="text-2xl font-bold text-white mb-6">Caractéristiques techniques</h2>
                <div class="grid md:grid-cols-2 gap-6">
                    {% for key, value in product.specifications %}
                        <div class="flex justify-between items-center py-3 border-b border-gray-700">
                            <span class="text-gray-400 capitalize">{{ key|replace({'_': ' '}) }}</span>
                            <span class="text-white font-semibold">{{ value }}</span>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        <!-- Back to Catalogue -->
        <div class="text-center">
            <a href="{{ path('app_catalogue') }}" class="inline-flex items-center px-6 py-3 bg-gray-800 text-gray-300 rounded-lg hover:bg-gray-700 transition">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                Retour au catalogue
            </a>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-gray-900 border-t border-gray-800 mt-20 py-12">
        <div class="container mx-auto px-4 text-center">
            <p class="text-gray-400">&copy; 2026 GearForge. Tous droits réservés.</p>
        </div>
    </footer>
</div>
{% endblock %}
