{% extends 'base.html.twig' %}

{% block title %}Pro Players - GearForge{% endblock %}

{% block body %}
<div class="relative isolate overflow-x-hidden" style="font-family:var(--font-pixel), sans-serif;">

  <div class="pointer-events-none fixed inset-0 -z-10"
       style="background:
         linear-gradient(180deg, rgba(18,10,46,0.97), rgba(11,7,32,1)),
         linear-gradient(90deg, rgba(233,221,255,0.07) 1px, transparent 1px),
         linear-gradient(0deg,  rgba(233,221,255,0.07) 1px, transparent 1px),
         repeating-linear-gradient(45deg, rgba(233,221,255,0.05) 0 2px, rgba(0,0,0,0) 2px 5px);
         background-size: auto, 5px 5px, 5px 5px, auto;">
  </div>

  <div class="container mx-auto px-6 pt-12 pb-24">

    <div class="text-center mb-12">
      <p class="text-[8px] tracking-[0.4em] mb-2" style="color:var(--secondary);">ESPORT</p>
      <h1 class="text-2xl md:text-3xl tracking-widest" style="color:var(--pixel-head); text-shadow:3px 3px 0 var(--pixel-shadow);">PRO PLAYERS</h1>
      <div class="h-[2px] w-16 mx-auto mt-4 rounded-full" style="background:linear-gradient(90deg, var(--pixel-accent), var(--tertiary));"></div>
      <p class="mt-4 text-[8px] tracking-wide" style="font-family:var(--font-ui),sans-serif; font-size:13px; color:rgba(233,221,255,0.45);">Découvre la configuration des pros et recrée leur setup.</p>
    </div>

    <div id="categories-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-5 max-w-4xl mx-auto">
      <div class="game-cat-card" onclick="showRoster('valorant')">
        <img src="https://static.actugaming.net/media/2020/06/valorant.jpeg" alt="Valorant" class="game-cat-card__img" />
        <span class="game-cat-card__name">VALORANT</span>
      </div>
      <div class="game-cat-card" onclick="showRoster('csgo')">
        <img src="https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/730/header.jpg?t=1749053861" alt="CS:GO 2" class="game-cat-card__img" />
        <span class="game-cat-card__name">CS:GO 2</span>
      </div>
      <div class="game-cat-card" onclick="showRoster('lol')">
        <img src="https://store-images.s-microsoft.com/image/apps.18996.14127010465288187.f9de4a96-0ee4-4da3-bf66-d4132b38c599.caf661a7-e0b3-492d-b91b-63627e47283e" alt="League of Legends" class="game-cat-card__img" />
        <span class="game-cat-card__name">LEAGUE OF LEGENDS</span>
      </div>
      <div class="game-cat-card" onclick="showRoster('fortnite')">
        <img src="https://cdn1.epicgames.com/offer/fn/FNECO_39-40_LoveAndLegends_EGS_Launcher_KeyArt_Blade_2560x1440_2560x1440-407af99db5db41f2a0596d35eb57b7d4" alt="Fortnite" class="game-cat-card__img" />
        <span class="game-cat-card__name">FORTNITE</span>
      </div>
      <div class="game-cat-card" onclick="showRoster('influenceur')">
        <img src="https://m.media-amazon.com/images/I/21kRx-CJsUL.png" alt="Influenceurs" class="game-cat-card__img" />
        <span class="game-cat-card__name">INFLUENCEURS</span>
      </div>
    </div>

    <div id="roster-section" style="display:none;">
      <div class="flex items-center gap-6 mb-8">
        <button onclick="showCategories()" class="cart-action-btn flex items-center gap-2">
          <span class="css-arrow-left" aria-hidden="true"></span> CATÉGORIES
        </button>
        <span id="roster-title" class="text-[9px] tracking-widest" style="color:var(--pixel-head);"></span>
      </div>
      <div id="roster-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-5"></div>
    </div>

  </div>

  {{ include('components/_footer.html.twig') }}
</div>

<script>
const players = {};
{% for player in players %}
    if (!players['{{ player.game|lower }}']) players['{{ player.game|lower }}'] = [];
    players['{{ player.game|lower }}'].push({
        id: {{ player.id }},
        name: '{{ player.name|e('js') }}',
        role: '{{ player.role|e('js') }}',
        team: '{{ player.team|e('js') }}',
        country: '{{ player.country|e('js') }}',
        photo: '{{ player.photo|e('js') }}'
    });
{% endfor %}

const gameTitles = {
    valorant: 'VALORANT',
    csgo: 'CS:GO 2',
    lol: 'LEAGUE OF LEGENDS',
    fortnite: 'FORTNITE',
    influenceur: 'INFLUENCEURS'
};

function showCategories() {
    document.getElementById('categories-grid').style.display = '';
    document.getElementById('roster-section').style.display = 'none';
}

function showRoster(game) {
    document.getElementById('categories-grid').style.display = 'none';
    document.getElementById('roster-section').style.display = '';
    document.getElementById('roster-title').textContent = gameTitles[game] || game.toUpperCase();
    const grid = document.getElementById('roster-grid');
    grid.innerHTML = '';
    (players[game] || []).forEach(player => {
        const card = document.createElement('div');
        card.className = 'pro-card';
        const img = player.photo
            ? `<img src="${player.photo}" alt="${player.name}" class="pro-card__img" />`
            : `<div class="pro-card__img pro-card__img--placeholder"></div>`;
        card.innerHTML = `
            ${img}
            <p class="pro-card__name">${player.name}</p>
            <p class="pro-card__role">${player.role}</p>
            <p class="pro-card__team">${player.team} · ${player.country}</p>
        `;
        card.addEventListener('click', () => {
            window.location.href = '/player/' + encodeURIComponent(player.id);
        });
        grid.appendChild(card);
    });
}
</script>
{% endblock %}

